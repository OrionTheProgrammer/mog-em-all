msgid "Usage: bmi <weight kg> <height cm>, for example: bmi 78,5 176"
msgstr "Uso: imc <peso kg> <altura cm>, por ejemplo: imc 78,5 176"

#: crates/mog-ui/ui/theme/labels.slint:174

#: crates/mog-ui/ui/theme/labels.slint:205
msgctxt "Labels"
msgid ""
"Write a task (pay rent tomorrow), an amount (12.500 lunch) or a command: go "
"<module> · bmi <kg> <cm> · lang es|en"
msgstr ""
"Escribe una tarea (pagar arriendo mañana), un monto (12.500 almuerzo) o un "
"comando: ir <módulo> · imc <kg> <cm> · idioma es|en"

#: crates/mog-ui/ui/theme/labels.slint:206
msgctxt "Labels"
msgid "Unknown command. Type help to see the list."
msgstr "Comando desconocido. Escribe ayuda para ver la lista."

#: crates/mog-ui/ui/theme/labels.slint:207
msgctxt "Labels"
msgid "Usage: go <module>, for example: go training"
msgstr "Uso: ir <módulo>, por ejemplo: ir entrenamiento"

#: crates/mog-ui/ui/theme/labels.slint:208
msgctxt "Labels"
msgid "Usage: bmi <weight kg> <height cm>, for example: bmi 78,5 176"
msgstr "Uso: imc <peso kg> <altura cm>, por ejemplo: imc 78,5 176"

#: crates/mog-ui/ui/theme/labels.slint:209
msgctxt "Labels"
msgid "Usage: lang es or lang en"
msgstr "Uso: idioma es o idioma en"

#: crates/mog-ui/ui/theme/labels.slint:210
msgctxt "Labels"
msgid "Out of range: weight must be 20 to 400 kg and height 100 to 250 cm."
msgstr ""
"Fuera de rango: el peso debe estar entre 20 y 400 kg y la altura entre 100 y "
"250 cm."

#: crates/mog-ui/ui/theme/labels.slint:211
msgctxt "Labels"
msgid "That language is not available yet."
msgstr "Ese idioma todavía no está disponible."

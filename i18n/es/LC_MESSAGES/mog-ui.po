msgid "Usage: lang es or lang en"
msgstr "Uso: idioma es o idioma en"

#: crates/mog-ui/ui/theme/labels.slint:175
msgctxt "Labels"
msgid "Out of range: weight must be 20 to 400 kg and height 100 to 250 cm."
msgstr ""
"Fuera de rango: el peso debe estar entre 20 y 400 kg y la altura entre 100 y "
"250 cm."


import { Theme } from "theme/theme.slint";
import { BmiResult, OperatorInfo, WeekStats, Clock, CommandFeedback, RecordRow, LevelUp } from "types.slint";
import { ScheduleState, Block, DayColumn } from "state/schedule.slint";
import { TrainingState, ExerciseItem, RoutineItem, RoutineExerciseRow, RoutineDetail, CurrentExercise, SetRow, SessionRow, ActiveSession } from "state/training.slint";
import { Scanlines } from "components/effects.slint";
import { BootScreen } from "screens/boot.slint";
import { Hud } from "screens/hud.slint";
import { LevelUpScreen } from "screens/levelup.slint";

export { BmiResult, OperatorInfo, WeekStats, Clock, CommandFeedback, RecordRow, LevelUp }
export { ScheduleState, Block, DayColumn }
export { TrainingState, ExerciseItem, RoutineItem, RoutineExerciseRow, RoutineDetail, CurrentExercise, SetRow, SessionRow, ActiveSession }

export component AppWindow inherits Window {
    title: "mog 'em all";
    icon: @image-url("assets/icon.png");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1100px;
    min-height: 700px;
    background: Theme.bg;
    default-font-family: Theme.font-display;

    in property <string> version;
    in property <float> boot-progress;
    in property <string> user-name;
    in property <bool> booted;
    in property <OperatorInfo> operator;
    in property <WeekStats> week;
    in property <Clock> clock;
    in property <CommandFeedback> feedback;
    in property <string> language;
    // 0 normal, 1 la base es de una versión más nueva, 2 no se pudo abrir la base
    in property <int> storage-status;
    in-out property <LevelUp> level-up;
    in-out property <BmiResult> bmi;
    in-out property <int> current-module: 0;
    callback compute-bmi(string, string) -> BmiResult;
    callback select-language(string);
    callback run-command(string);
    callback skip-boot();
    // Se llama al cambiar de pestaña, para refrescar lo que dependa de otras.
    callback tab-changed(int);


    hud := Hud {
        y: root.booted ? 0px : 24px;
        opacity: root.booted ? 1 : 0;
        animate y, opacity { duration: Theme.slow; delay: 150ms; easing: ease-out; }
        active: root.booted;
        version: root.version;
        language: root.language;
        operator: root.operator;
        week: root.week;
        clock: root.clock;
        feedback: root.feedback;
        storage-status: root.storage-status;

        bmi <=> root.bmi;
        current <=> root.current-module;
        compute-bmi(w, h) => { return root.compute-bmi(w, h); }
        select-language(lang) => { root.select-language(lang); }
        run-command(text) => { root.run-command(text); }
    }

    if root.level-up.visible: LevelUpScreen {
        data: root.level-up;
        dismiss => {
            root.level-up.visible = false;
            hud.take-focus();
        }
    }

    BootScreen {
        progress: root.boot-progress;
        user-name: root.user-name;
        operator: root.operator;
        opacity: root.booted ? 0 : 1;
        visible: self.opacity > 0.01;
        animate opacity { duration: Theme.normal; }
        skip => { root.skip-boot(); }
    }

    Scanlines { }

    changed current-module => { root.tab-changed(root.current-module); }

    // Cuando termina la carga, el HUD recibe el foco del teclado.
    changed booted => {
        if (root.booted) {
            hud.take-focus();
        }
    }
}

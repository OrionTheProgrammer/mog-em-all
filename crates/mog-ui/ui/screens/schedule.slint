import { Theme } from "../theme/theme.slint";
import { Labels } from "../theme/labels.slint";
import { ScheduleState, Block, DayColumn } from "../state/schedule.slint";
import { TermButton } from "../components/button.slint";
import { TermInput } from "../components/input.slint";
import { SectionLabel, KeyHint } from "../components/hud.slint";

// Un bloque dentro de la columna de un día.
component BlockView inherits Rectangle {
    in property <Block> block;
    in property <length> per-minute;
    in property <int> from-min;
    in property <length> column-width;
    callback clicked;

    property <color> tint: Theme.schedule-kinds[root.block.kind];
    x: root.block.lane * (root.column-width / root.block.lanes) + 1px;
    y: (root.block.start-min - root.from-min) * root.per-minute;
    width: root.column-width / root.block.lanes - 3px;
    height: Math.max(18px, (root.block.end-min - root.block.start-min) * root.per-minute - 2px);
    background: touch.has-hover ? root.tint.transparentize(0.62) : root.tint.transparentize(0.78);
    border-width: root.block.conflict ? 1px : 0px;
    border-color: Theme.amber;
    clip: true;

    Rectangle {
        x: 0;
        width: 3px;
        background: root.tint;
    }

    VerticalLayout {
        padding-left: 7px;
        padding-right: 4px;
        padding-top: 3px;
        alignment: start;
        Text {
            text: root.block.title;
            overflow: elide;
            color: Theme.text;
            font-family: Theme.font-display;
            font-weight: 700;
            font-size: Theme.size-sm;
        }
        if root.height > 34px: Text {
            text: Labels.time(root.block.start-min) + "–" + Labels.time(root.block.end-min);
            overflow: elide;
            color: Theme.text-dim;
            font-family: Theme.font-mono;
            font-size: Theme.size-xs;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Columna de un día: encabezado, rutinas sin hora y la línea de tiempo.
component DayView {
    min-width: 70px;
    horizontal-stretch: 1;
    in property <DayColumn> column;
    in property <int> index;
    in property <length> per-minute;
    in property <int> hours;

    VerticalLayout {
        spacing: 4px;

        Rectangle {
            height: 40px;
            background: root.column.today ? Theme.red-faint : transparent;
            border-width: root.column.today ? 1px : 0px;
            border-color: Theme.red;
            // Sin layout: un texto dentro de un layout fijaría el ancho máximo de la columna.
            Rectangle {
                Text {
                    y: 4px;
                    width: parent.width;
                    text: Labels.weekday(root.column.weekday);
                    horizontal-alignment: center;
                    color: root.column.today ? Theme.red : Theme.text-dim;
                    font-family: Theme.font-display;
                    font-weight: 700;
                    font-size: Theme.size-sm;
                    letter-spacing: 3px;
                }
                Text {
                    y: 22px;
                    width: parent.width;
                    text: Labels.pad(root.column.day) + "/" + Labels.pad(root.column.month);
                    horizontal-alignment: center;
                    color: root.column.today ? Theme.red-glow : Theme.text;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-xs;
                }
            }
        }

        // Rutinas del día que no tienen hora fija.
        Rectangle {
            height: 24px;
            HorizontalLayout {
                spacing: 2px;
                for item in root.column.untimed: Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.schedule-kinds[5].transparentize(0.8);
                    border-width: 1px;
                    border-color: Theme.schedule-kinds[5].transparentize(0.4);
                    Text {
                        text: item.title;
                        overflow: elide;
                        color: Theme.cyan;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-xs;
                        width: parent.width - 6px;
                        horizontal-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ScheduleState.open-routine(item.id); }
                    }
                }
            }
        }

        timeline := Rectangle {
            vertical-stretch: 1;
            background: root.column.today ? #ff2a3d08 : transparent;
            border-width: 1px;
            border-color: #7a142055;
            clip: true;

            // Clic en un hueco: nuevo evento a esa hora (redondeada a la media hora).
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    ScheduleState.new-event-at(root.index,
                        ScheduleState.from-min + Math.floor(self.mouse-y / root.per-minute / 30) * 30);
                }
            }

            for h in root.hours: Rectangle {
                y: h * 60 * root.per-minute;
                height: 1px;
                background: #7a142040;
            }

            for block in root.column.blocks: BlockView {
                block: block;
                per-minute: root.per-minute;
                from-min: ScheduleState.from-min;
                column-width: timeline.width;
                clicked => {
                    if (block.source == 0) {
                        ScheduleState.edit-event(block.id);
                    } else {
                        ScheduleState.open-routine(block.id);
                    }
                }
            }

            // Línea de "ahora"
            if root.column.today && ScheduleState.now-min >= ScheduleState.from-min && ScheduleState.now-min <= ScheduleState.to-min: Rectangle {
                y: (ScheduleState.now-min - ScheduleState.from-min) * root.per-minute;
                height: 2px;
                background: Theme.cyan;
            }
        }
    }
}

// Formulario para crear o editar un evento.
component EventForm {
    VerticalLayout {
        spacing: Theme.gap-sm;
        alignment: start;

        SectionLabel { text: ScheduleState.form-id == 0 ? @tr("NEW EVENT") : @tr("EDIT EVENT"); }
        TermInput {
            label: @tr("WHAT");
            text <=> ScheduleState.form-title;
        }
        SectionLabel { text: @tr("TYPE"); }
        HorizontalLayout {
            spacing: 3px;
            for k in 5: TermButton {
                text: Labels.event-kind(k);
                compact: true;
                tiny: true;
                min-width: 0px;
                horizontal-stretch: 1;
                active: ScheduleState.form-kind == k;
                clicked => { ScheduleState.form-kind = k; }
            }
        }
        HorizontalLayout {
            spacing: 3px;
            TermButton {
                horizontal-stretch: 1;
                text: @tr("EVERY WEEK");
                compact: true;
                active: ScheduleState.form-weekly;
                clicked => { ScheduleState.form-weekly = true; }
            }
            TermButton {
                horizontal-stretch: 1;
                text: @tr("ONCE");
                compact: true;
                active: !ScheduleState.form-weekly;
                clicked => { ScheduleState.form-weekly = false; }
            }
        }
        if ScheduleState.form-weekly: HorizontalLayout {
            spacing: 2px;
            for i in 7: TermButton {
                text: Labels.weekday(i);
                compact: true;
                tiny: true;
                min-width: 0px;
                horizontal-stretch: 1;
                active: ScheduleState.form-days[i];
                clicked => { ScheduleState.toggle-form-day(i); }
            }
        }
        if !ScheduleState.form-weekly: TermInput {
            label: @tr("DATE (day/month)");
            text <=> ScheduleState.form-date;
        }
        HorizontalLayout {
            spacing: Theme.gap-sm;
            TermInput {
                label: @tr("FROM");
                text <=> ScheduleState.form-start;
            }
            TermInput {
                label: @tr("TO");
                text <=> ScheduleState.form-end;
            }
        }
        SectionLabel { text: @tr("REMIND ME"); }
        HorizontalLayout {
            spacing: 3px;
            for r[i] in [0, 5, 10, 15, 30, 60]: TermButton {
                text: i == 0 ? @tr("No") : r + "'";
                compact: true;
                tiny: true;
                min-width: 0px;
                horizontal-stretch: 1;
                active: ScheduleState.form-reminder == i;
                clicked => { ScheduleState.form-reminder = i; }
            }
        }
        if ScheduleState.form-error != 0: Text {
            text: ScheduleState.form-error == 1 ? @tr("Write what it is.")
                : ScheduleState.form-error == 2 ? @tr("Write the times as 18:30, and the end after the start.")
                : ScheduleState.form-error == 3 ? @tr("Pick at least one day.")
                : @tr("Write the date as day/month, for example 24/11.");
            wrap: word-wrap;
            color: Theme.amber;
            font-family: Theme.font-mono;
            font-size: Theme.size-xs;
        }
        HorizontalLayout {
            spacing: Theme.gap-sm;
            TermButton {
                horizontal-stretch: 1;
                text: @tr("SAVE");
                active: true;
                clicked => { ScheduleState.save-event(); }
            }
            TermButton {
                text: @tr("CANCEL");
                compact: true;
                clicked => { ScheduleState.close-form(); }
            }
        }
        if ScheduleState.form-id != 0: TermButton {
            text: @tr("DELETE EVENT");
            compact: true;
            clicked => { ScheduleState.delete-event(ScheduleState.form-id); }
        }
    }
}

// Hora fija de una rutina en el horario.
component RoutineTimeForm {
    VerticalLayout {
        spacing: Theme.gap-sm;
        alignment: start;
        SectionLabel { text: @tr("TRAINING"); }
        Text {
            text: ScheduleState.routine-name;
            wrap: word-wrap;
            color: Theme.cyan;
            font-family: Theme.font-display;
            font-weight: 700;
            font-size: 26px;
        }
        Text {
            text: @tr("Its days are set in TRAINING. Here you can give it a time so it shows up as a block.");
            wrap: word-wrap;
            color: Theme.text-dim;
            font-family: Theme.font-mono;
            font-size: Theme.size-xs;
        }
        HorizontalLayout {
            spacing: Theme.gap-sm;
            TermInput {
                label: @tr("TIME");
                text <=> ScheduleState.routine-start;
            }
            TermInput {
                label: @tr("MINUTES");
                text <=> ScheduleState.routine-duration;
            }
        }
        if ScheduleState.routine-error: Text {
            text: @tr("Write the time as 19:00 and the length in minutes (10 to 600).");
            wrap: word-wrap;
            color: Theme.amber;
            font-family: Theme.font-mono;
            font-size: Theme.size-xs;
        }
        HorizontalLayout {
            spacing: Theme.gap-sm;
            TermButton {
                horizontal-stretch: 1;
                text: @tr("SAVE TIME");
                active: true;
                clicked => { ScheduleState.save-routine-time(); }
            }
            TermButton {
                text: @tr("NO TIME");
                compact: true;
                clicked => { ScheduleState.clear-routine-time(); }
            }
        }
        TermButton {
            text: @tr("CLOSE");
            compact: true;
            clicked => { ScheduleState.close-form(); }
        }
    }
}

// Pestaña HORARIOS: la semana en una grilla, con eventos y días de entrenamiento.
export component Schedule {
    property <float> shown: 0;
    opacity: root.shown;
    animate opacity { duration: Theme.normal; }
    init => { root.shown = 1; }

    property <int> hours: Math.round((ScheduleState.to-min - ScheduleState.from-min) / 60);
    // Ancho explícito de la grilla: lo que deja el panel lateral (330 px), los márgenes y el espacio entre ambos.
    property <length> grid-width: root.width - 64px - 24px - 330px;
    property <length> day-width: (root.grid-width - 40px - 7 * 4px) / 7;

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 20px;
        padding-bottom: 12px;
        spacing: 24px;

        VerticalLayout {
            width: root.grid-width;
            spacing: Theme.gap-sm;

            HorizontalLayout {
                spacing: Theme.gap-sm;
                Text {
                    text: ScheduleState.days.length == 7
                        ? @tr("WEEK OF {}/{} TO {}/{}", Labels.pad(ScheduleState.days[0].day), Labels.pad(ScheduleState.days[0].month), Labels.pad(ScheduleState.days[6].day), Labels.pad(ScheduleState.days[6].month))
                        : "";
                    vertical-alignment: center;
                    color: Theme.red;
                    font-family: Theme.font-display;
                    font-weight: 700;
                    font-size: Theme.size-lg;
                    letter-spacing: 3px;
                }
                if ScheduleState.conflicts > 0: Text {
                    text: @tr("{n} clash" | "{n} clashes" % ScheduleState.conflicts);
                    vertical-alignment: center;
                    color: Theme.amber;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-sm;
                }
                Rectangle { horizontal-stretch: 1; }
                TermButton { text: "◀"; compact: true; clicked => { ScheduleState.prev-week(); } }
                TermButton {
                    text: @tr("THIS WEEK");
                    compact: true;
                    active: ScheduleState.week-offset == 0;
                    clicked => { ScheduleState.this-week(); }
                }
                TermButton { text: "▶"; compact: true; clicked => { ScheduleState.next-week(); } }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 4px;

                // Horas
                VerticalLayout {
                    width: 40px;
                    Rectangle { height: 40px + 4px + 24px + 4px; }
                    hours-col := Rectangle {
                        vertical-stretch: 1;
                        for h in root.hours: Text {
                            y: h * 60 * (hours-col.height / Math.max(1, ScheduleState.to-min - ScheduleState.from-min)) - 6px;
                            text: Labels.time(ScheduleState.from-min + h * 60);
                            color: Theme.red-dim;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-xs;
                        }
                    }
                }

                for column[i] in ScheduleState.days: DayView {
                    width: root.day-width;
                    column: column;
                    index: i;
                    hours: root.hours;
                    per-minute: hours-col.height / Math.max(1, ScheduleState.to-min - ScheduleState.from-min);
                }
            }
        }

        // Panel lateral
        Rectangle {
            width: 330px;
            background: Theme.panel;
            VerticalLayout {
                padding: 16px;
                if ScheduleState.form-open: EventForm { }
                if !ScheduleState.form-open && ScheduleState.routine-id != 0: RoutineTimeForm { }
                if !ScheduleState.form-open && ScheduleState.routine-id == 0: VerticalLayout {
                    spacing: Theme.gap-md;
                    alignment: start;
                    SectionLabel { text: @tr("HOW IT WORKS"); }
                    Text {
                        text: @tr("Click an empty slot in the grid to add a class, a work shift or anything else at that time. Click a block to edit it.");
                        wrap: word-wrap;
                        color: Theme.text;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                    }
                    Text {
                        text: @tr("Your routines show up on their days by themselves. Give one a time and it becomes a block.");
                        wrap: word-wrap;
                        color: Theme.text-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                    }
                    SectionLabel { text: @tr("TYPES"); }
                    for k in 6: HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Rectangle {
                            width: 14px;
                            height: 14px;
                            background: Theme.schedule-kinds[k];
                        }
                        Text {
                            text: Labels.event-kind(k);
                            vertical-alignment: center;
                            color: Theme.text;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-sm;
                        }
                    }
                    SectionLabel { text: @tr("LEFT TODAY"); }
                    if ScheduleState.today-left.length == 0: Text {
                        text: @tr("Nothing else today.");
                        color: Theme.text-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                    }
                    for b in ScheduleState.today-left: HorizontalLayout {
                        spacing: Theme.gap-sm;
                        Text {
                            text: Labels.time(b.start-min);
                            color: Theme.schedule-kinds[b.kind];
                            font-family: Theme.font-mono;
                            font-size: Theme.size-sm;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: b.title;
                            overflow: elide;
                            color: Theme.text;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-sm;
                        }
                    }
                }
            }
        }
    }
}

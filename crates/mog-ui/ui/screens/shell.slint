import { Theme } from "../theme/theme.slint";
import { BmiResult, OperatorInfo } from "../types.slint";
import { TermButton } from "../components/button.slint";
import { GlitchText } from "../components/effects.slint";
import { Dashboard } from "dashboard.slint";
import { Placeholder } from "placeholder.slint";

// Estructura principal: barra superior, navegación de módulos, contenido y barra de estado.
export component Shell inherits Rectangle {
    in property <string> version;
    in property <string> language;
    in property <OperatorInfo> operator;
    in-out property <int> current: 0;
    callback compute-bmi(string, string) -> BmiResult;
    callback select-language(string);

    property <[string]> modules: [
        @tr("DASHBOARD"),
        @tr("WORKOUTS"),
        @tr("ROUTINES"),
        @tr("TASKS"),
        @tr("SCHEDULE"),
        @tr("FINANCES"),
        @tr("SETTINGS"),
    ];

    background: Theme.bg;

    VerticalLayout {
        // Barra superior
        HorizontalLayout {
            height: 64px;
            padding-left: Theme.gap-lg;
            padding-right: Theme.gap-lg;
            spacing: Theme.gap-md;

            VerticalLayout {
                alignment: center;
                GlitchText {
                    text: "MOG 'EM ALL";
                    font-size: 30px;
                    letter-spacing: 4px;
                }
            }
            Text {
                text: "v" + root.version;
                vertical-alignment: center;
                color: Theme.red-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-xs;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    TermButton {
                        text: "ES";
                        compact: true;
                        active: root.language == "es";
                        clicked => { root.select-language("es"); }
                    }
                    TermButton {
                        text: "EN";
                        compact: true;
                        active: root.language == "en";
                        clicked => { root.select-language("en"); }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.red-dim;
        }

        HorizontalLayout {
            vertical-stretch: 1;

            // Navegación
            VerticalLayout {
                width: 230px;
                padding: Theme.gap-lg;
                spacing: Theme.gap-sm;
                alignment: start;
                for module[i] in root.modules: TermButton {
                    text: module;
                    active: root.current == i;
                    clicked => { root.current = i; }
                }
            }

            Rectangle {
                width: 1px;
                background: Theme.red-dim;
            }

            // Contenido
            Rectangle {
                horizontal-stretch: 1;
                if root.current == 0: Dashboard {
                    width: 100%;
                    height: 100%;
                    operator: root.operator;
                    compute-bmi(w, h) => { return root.compute-bmi(w, h); }
                }
                if root.current != 0: Placeholder {
                    width: 100%;
                    height: 100%;
                    module-name: root.modules[root.current];
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.red-dim;
        }

        // Barra de estado
        HorizontalLayout {
            height: 28px;
            padding-left: Theme.gap-lg;
            padding-right: Theme.gap-lg;
            Text {
                text: @tr("LOCAL MODE · DATA STORED ON THIS DEVICE");
                vertical-alignment: center;
                color: Theme.red-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-xs;
                letter-spacing: 1px;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: "Made with Slint";
                vertical-alignment: center;
                color: Theme.red-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-xs;
            }
        }
    }
}

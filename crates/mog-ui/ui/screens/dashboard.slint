import { Theme } from "../theme/theme.slint";
import { Labels } from "../theme/labels.slint";
import { BmiResult, OperatorInfo } from "../types.slint";
import { Panel } from "../components/panel.slint";
import { TermInput } from "../components/input.slint";
import { SegmentBar } from "../components/progress.slint";
import { GlitchText } from "../components/effects.slint";

component OperatorCard inherits Panel {
    in property <OperatorInfo> operator;
    title: @tr("OPERATOR");
    highlighted: true;

    HorizontalLayout {
        spacing: Theme.gap-lg;
        VerticalLayout {
            alignment: start;
            Text {
                text: @tr("LEVEL");
                color: Theme.text-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-xs;
                letter-spacing: 2px;
            }
            GlitchText {
                text: root.operator.level < 10 ? "0" + root.operator.level : "" + root.operator.level;
                font-size: 72px;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.gap-sm;
            Text {
                text: Labels.tier(root.operator.tier);
                color: Theme.cyan;
                font-family: Theme.font-display;
                font-size: Theme.size-lg;
                font-weight: 700;
                letter-spacing: 4px;
            }
            SegmentBar {
                height: 12px;
                value: root.operator.xp-for-next > 0 ? root.operator.xp-in-level / root.operator.xp-for-next : 1;
            }
            Text {
                text: root.operator.xp-for-next > 0
                    ? @tr("{} / {} XP to next level", root.operator.xp-in-level, root.operator.xp-for-next)
                    : @tr("Maximum level");
                color: Theme.text-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-xs;
            }
        }
    }
}

component BmiCard inherits Panel {
    callback compute-bmi(string, string) -> BmiResult;
    property <BmiResult> result;
    title: @tr("BODY MASS INDEX");

    function refresh() {
        root.result = root.compute-bmi(weight.text, height.text);
    }

    HorizontalLayout {
        spacing: Theme.gap-md;
        weight := TermInput {
            label: @tr("WEIGHT");
            suffix: "kg";
            edited => { root.refresh(); }
        }
        height := TermInput {
            label: @tr("HEIGHT");
            suffix: "cm";
            edited => { root.refresh(); }
        }
    }

    HorizontalLayout {
        spacing: Theme.gap-md;
        Text {
            text: root.result.valid ? Math.round(root.result.value * 10) / 10 : "--.-";
            color: root.result.valid ? Theme.red-glow : Theme.red-dim;
            font-family: Theme.font-mono;
            font-size: Theme.size-xl;
            vertical-alignment: center;
        }
        Text {
            text: root.result.valid ? Labels.bmi-category(root.result.category) : @tr("Enter weight and height");
            color: root.result.valid ? Theme.cyan : Theme.text-dim;
            font-family: Theme.font-display;
            font-size: Theme.size-md;
            font-weight: 700;
            letter-spacing: 2px;
            vertical-alignment: center;
        }
    }

    Text {
        text: @tr("Reference only: BMI does not tell muscle from fat.");
        wrap: word-wrap;
        color: Theme.red-dim;
        font-family: Theme.font-mono;
        font-size: Theme.size-xs;
    }
}

export component Dashboard {
    in property <OperatorInfo> operator;
    callback compute-bmi <=> bmi.compute-bmi;

    property <float> shown: 0;
    opacity: root.shown;
    animate opacity { duration: Theme.normal; }
    init => { root.shown = 1; }

    VerticalLayout {
        padding: Theme.gap-lg;
        spacing: Theme.gap-lg;
        alignment: start;

        HorizontalLayout {
            spacing: Theme.gap-lg;
            OperatorCard {
                horizontal-stretch: 1;
                operator: root.operator;
            }
            bmi := BmiCard {
                horizontal-stretch: 1;
            }
        }
    }
}

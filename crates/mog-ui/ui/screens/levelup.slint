import { Theme } from "../theme/theme.slint";
import { Labels } from "../theme/labels.slint";
import { LevelUp } from "../types.slint";
import { SegmentBar } from "../components/progress.slint";
import { SectionLabel, StatRow } from "../components/hud.slint";

component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    background: Theme.panel;
    min-width: 150px;

    Rectangle { y: 0; height: 3px; background: Theme.red; }
    VerticalLayout {
        padding: 14px;
        spacing: 4px;
        SectionLabel { text: root.label; }
        Text {
            text: root.value;
            color: Theme.red-glow;
            font-family: Theme.font-display;
            font-weight: 700;
            font-size: 32px;
        }
    }
}

// Línea del detalle de XP que aparece cuando `progress` pasa `at`.
component XpLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.red-glow;
    in property <float> progress;
    in property <float> at;

    opacity: Math.max(0, Math.min(1, (root.progress - root.at) / 0.08));

    Text {
        horizontal-stretch: 1;
        text: root.label;
        color: Theme.text;
        font-family: Theme.font-mono;
        font-size: Theme.size-md;
    }
    Text {
        text: root.value;
        color: root.value-color;
        font-family: Theme.font-mono;
        font-size: Theme.size-md;
    }
}

// Pantalla al terminar un entrenamiento: resumen, récords, XP y nivel.
// Enter, Esc o un clic la cierran.
export component LevelUpScreen inherits Rectangle {
    in property <LevelUp> data;
    callback dismiss();

    background: @radial-gradient(circle, #1f0508 0%, #070102 60%);

    // 0 → 1 recorre la secuencia de aparición.
    property <float> progress: 0;
    animate progress { duration: 3200ms; easing: linear; }
    property <bool> leveled: root.data.level-after > root.data.level-before && root.progress >= 0.72;
    property <float> bar: root.progress < 0.62
        ? root.data.progress-before
        : root.leveled
            ? root.data.progress-after
            : root.data.progress-before + (root.data.progress-after - root.data.progress-before) * Math.min(1, (root.progress - 0.62) / 0.2);

    init => {
        root.progress = 1;
        keys.focus();
    }

    TouchArea {
        clicked => { root.dismiss(); }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Escape || event.text == " ") {
                root.dismiss();
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        padding-left: 64px;
        padding-right: 64px;
        padding-top: 48px;
        padding-bottom: 36px;
        spacing: 28px;

        HorizontalLayout {
            spacing: 18px;
            Text {
                horizontal-stretch: 0;
                text: @tr("SESSION COMPLETE");
                color: Theme.red;
                font-family: Theme.font-display;
                font-weight: 700;
                font-size: 52px;
                letter-spacing: 6px;
            }
            Text {
                horizontal-stretch: 1;
                text: root.data.session-name.to-uppercase();
                vertical-alignment: center;
                color: Theme.text-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-sm;
                letter-spacing: 3px;
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 56px;

            // Resumen y récords
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.gap-lg;
                alignment: start;

                HorizontalLayout {
                    spacing: Theme.gap-md;
                    StatTile { label: @tr("DURATION"); value: root.data.duration-min + " min"; }
                    StatTile { label: @tr("VOLUME"); value: Labels.kg(root.data.volume-kg); }
                    StatTile { label: @tr("SETS"); value: root.data.sets; }
                }

                SectionLabel { text: @tr("RECORDS"); }
                if root.data.records.length == 0: Text {
                    text: @tr("No new records this time. They count against your best earlier session.");
                    wrap: word-wrap;
                    color: Theme.text-dim;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-sm;
                }
                for record in root.data.records: Rectangle {
                    height: 46px;
                    border-width: 1px;
                    border-color: Theme.cyan;
                    background: #2ef2ff10;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: Theme.gap-md;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                background: Theme.cyan;
                                width: badge.preferred-width + 14px;
                                height: badge.preferred-height + 6px;
                                badge := Text {
                                    text: @tr("NEW");
                                    color: Theme.bg;
                                    font-family: Theme.font-display;
                                    font-weight: 700;
                                    font-size: Theme.size-sm;
                                    letter-spacing: 2px;
                                }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: Labels.exercise(record.code, record.name);
                            vertical-alignment: center;
                            color: Theme.text;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-sm;
                        }
                        Text {
                            text: @tr("Est. 1RM {} (was {})", Labels.kg(record.new-kg), Labels.kg(record.previous-kg));
                            vertical-alignment: center;
                            color: Theme.cyan;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-sm;
                        }
                    }
                }
            }

            // XP y nivel
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.gap-md;
                alignment: center;

                SectionLabel { text: @tr("SESSION XP"); }
                XpLine { label: @tr("Base for finishing"); value: "+" + root.data.base; progress: root.progress; at: 0.05; }
                XpLine { label: @tr("Minutes trained ({})", root.data.duration-min); value: "+" + root.data.minutes; progress: root.progress; at: 0.14; }
                XpLine { label: @tr("Personal records"); value: "+" + root.data.records-xp; value-color: Theme.cyan; progress: root.progress; at: 0.23; }
                XpLine {
                    label: @tr("Streak of {n} week" | "Streak of {n} weeks" % root.data.streak-weeks);
                    value: "× " + (root.data.streak-pct / 100);
                    value-color: Theme.amber;
                    progress: root.progress;
                    at: 0.32;
                }
                Rectangle { height: 1px; background: Theme.red-dim; }
                HorizontalLayout {
                    opacity: Math.max(0, Math.min(1, (root.progress - 0.44) / 0.06));
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("TOTAL");
                        vertical-alignment: center;
                        color: Theme.text;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-md;
                        letter-spacing: 3px;
                    }
                    Text {
                        text: root.data.over-cap ? "+0 XP" : "+" + root.data.total + " XP";
                        color: Theme.red;
                        font-family: Theme.font-display;
                        font-weight: 700;
                        font-size: 60px;
                    }
                }
                if root.data.over-cap: Text {
                    text: @tr("You already trained twice today, so this session doesn't add XP. It still counts for your streak and records.");
                    wrap: word-wrap;
                    color: Theme.amber;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-xs;
                }

                HorizontalLayout {
                    spacing: 22px;
                    padding-top: Theme.gap-lg;
                    Rectangle {
                        width: 200px;
                        height: 110px;
                        clip: true;
                        Text {
                            y: root.leveled ? -self.height : 0px;
                            animate y { duration: 260ms; easing: ease-out; }
                            text: root.data.level-before;
                            color: Theme.red-dim;
                            font-family: Theme.font-display;
                            font-weight: 700;
                            font-size: 110px;
                        }
                        Text {
                            y: root.leveled ? 0px : self.height;
                            animate y { duration: 260ms; easing: ease-out; }
                            text: root.data.level-after;
                            color: Theme.red;
                            font-family: Theme.font-display;
                            font-weight: 700;
                            font-size: 110px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.gap-sm;
                        Text {
                            text: @tr("LEVEL");
                            color: Theme.cyan;
                            font-family: Theme.font-display;
                            font-weight: 700;
                            font-size: 22px;
                            letter-spacing: 6px;
                        }
                        SegmentBar {
                            height: 14px;
                            segments: 30;
                            value: root.bar;
                        }
                        Text {
                            text: root.data.xp-for-next > 0
                                ? @tr("{} / {} XP · {}", root.data.xp-in-level, root.data.xp-for-next, Labels.rank(root.data.tier, root.data.division))
                                : Labels.rank(root.data.tier, root.data.division);
                            color: Theme.text-dim;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-xs;
                        }
                    }
                }
                if root.data.rank-change >= 2: Text {
                    opacity: root.leveled ? 1 : 0;
                    animate opacity { duration: Theme.normal; }
                    text: root.data.rank-change == 3
                        ? @tr("NEW RANK: {}", Labels.rank(root.data.tier, root.data.division))
                        : @tr("NEW DIVISION: {}", Labels.rank(root.data.tier, root.data.division));
                    color: Theme.amber;
                    font-family: Theme.font-display;
                    font-weight: 700;
                    font-size: 26px;
                    letter-spacing: 4px;
                }
            }
        }

        HorizontalLayout {
            Text {
                horizontal-stretch: 1;
                text: @tr("Only finishing workouts raises your level.");
                color: Theme.red-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-xs;
                letter-spacing: 1px;
            }
            Text {
                text: @tr("ENTER TO CONTINUE");
                color: Theme.text-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-xs;
                letter-spacing: 3px;
            }
        }
    }

    // Destello al subir de nivel
    Rectangle {
        background: Theme.red;
        opacity: root.leveled && root.progress < 0.8 ? 0.35 : 0;
        animate opacity { duration: 300ms; }
    }
}

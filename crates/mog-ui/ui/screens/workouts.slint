import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/theme.slint";
import { Labels } from "../theme/labels.slint";
import { ExerciseItem, SetRow, SessionRow, ActiveSession } from "../types.slint";
import { TermButton } from "../components/button.slint";
import { TermInput } from "../components/input.slint";
import { SectionLabel } from "../components/hud.slint";

// Fila de la lista de series.
component SetLine {
    in property <int> number;
    in property <SetRow> entry;
    in property <bool> newest;

    height: 34px;
    HorizontalLayout {
        spacing: Theme.gap-md;
        Text {
            width: 34px;
            text: "#" + root.number;
            vertical-alignment: center;
            color: Theme.red-dim;
            font-family: Theme.font-mono;
            font-size: Theme.size-sm;
        }
        Text {
            horizontal-stretch: 1;
            text: Labels.exercise(root.entry.code, root.entry.name);
            vertical-alignment: center;
            color: root.newest ? Theme.cyan : Theme.text;
            font-family: Theme.font-mono;
            font-size: Theme.size-sm;
        }
        Text {
            text: root.entry.kind == 2
                ? Labels.duration(root.entry.duration-s)
                : root.entry.kind == 1 && root.entry.weight <= 0
                    ? @tr("{} reps", root.entry.reps)
                    : root.entry.reps + " × " + Labels.kg(root.entry.weight);
            vertical-alignment: center;
            color: Theme.red-glow;
            font-family: Theme.font-mono;
            font-size: Theme.size-sm;
        }
    }
}

// Pestaña EJERCICIO: empezar una sesión, anotar series y terminarla.
export component Workouts {
    in property <[ExerciseItem]> exercises;
    in property <[SetRow]> sets;
    in property <[SessionRow]> recent;
    in property <ActiveSession> session;
    // segundos desde 1970, se actualiza cada segundo
    in property <int> now;
    callback start-session(string);
    // devuelve true si la serie se guardó (y entonces se limpian los campos)
    callback add-set(int, string, string, string) -> bool;
    callback undo-set();
    callback discard-session();
    callback finish-session();

    property <int> selected: 0;
    // Texto de los campos; vive aquí porque los campos cambian según el ejercicio.
    property <string> reps-text;
    property <string> weight-text;
    property <string> duration-text;
    // La última serie no se pudo guardar (dato fuera de rango o vacío).
    property <bool> rejected;
    property <ExerciseItem> current: root.exercises[root.selected];
    property <int> elapsed: Math.max(0, root.now - root.session.started-at);

    property <float> shown: 0;
    opacity: root.shown;
    animate opacity { duration: Theme.normal; }
    init => { root.shown = 1; }

    function submit-set() {
        if (root.add-set(root.current.id, root.reps-text, root.weight-text, root.duration-text)) {
            root.reps-text = "";
            root.duration-text = "";
            root.rejected = false;
        } else {
            root.rejected = true;
        }
    }

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 28px;
        padding-bottom: 20px;
        spacing: 32px;

        // Sesión
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 280px;
            spacing: Theme.gap-md;
            alignment: start;

            if !root.session.active: VerticalLayout {
                spacing: Theme.gap-md;
                SectionLabel { text: @tr("NEW SESSION"); }
                session-name := TermInput {
                    label: @tr("NAME");
                    text: @tr("Free session");
                }
                TermButton {
                    text: @tr("START SESSION");
                    active: true;
                    clicked => { root.start-session(session-name.text); }
                }

                Rectangle { height: Theme.gap-md; }
                SectionLabel { text: @tr("RECENT"); }
                if root.recent.length == 0: Text {
                    text: @tr("Your finished sessions will show up here.");
                    wrap: word-wrap;
                    color: Theme.text-dim;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-sm;
                }
                for item in root.recent: HorizontalLayout {
                    spacing: Theme.gap-md;
                    Text {
                        text: Labels.pad(item.day) + "/" + Labels.pad(item.month);
                        color: Theme.red-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: item.name;
                        overflow: elide;
                        color: Theme.text;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                    }
                    Text {
                        text: @tr("{} min · +{} XP", item.duration-min, item.xp);
                        color: Theme.cyan;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                    }
                }
            }

            if root.session.active: VerticalLayout {
                spacing: Theme.gap-md;
                SectionLabel { text: @tr("SESSION IN PROGRESS"); }
                Text {
                    text: root.session.name;
                    wrap: word-wrap;
                    color: Theme.red;
                    font-family: Theme.font-display;
                    font-weight: 700;
                    font-size: 34px;
                    letter-spacing: 2px;
                }
                Text {
                    text: Labels.duration(root.elapsed);
                    color: Theme.cyan;
                    font-family: Theme.font-mono;
                    font-size: 56px;
                }
                Text {
                    text: @tr("{n} set logged" | "{n} sets logged" % root.sets.length);
                    color: Theme.text-dim;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-sm;
                }
                Rectangle { height: Theme.gap-md; }
                TermButton {
                    text: @tr("FINISH SESSION");
                    active: true;
                    clicked => { root.finish-session(); }
                }
                TermButton {
                    text: @tr("UNDO LAST SET");
                    clicked => { root.undo-set(); }
                }
                TermButton {
                    text: @tr("DISCARD SESSION");
                    clicked => { root.discard-session(); }
                }
            }
        }

        // Ejercicio y serie
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 300px;
            spacing: Theme.gap-md;

            SectionLabel { text: @tr("EXERCISE"); }
            ScrollView {
                vertical-stretch: 1;
                min-height: 200px;
                VerticalLayout {
                    spacing: Theme.gap-sm;
                    alignment: start;
                    for item[i] in root.exercises: TermButton {
                        text: Labels.exercise(item.code, item.name);
                        compact: true;
                        active: root.selected == i;
                        clicked => {
                            root.selected = i;
                            root.rejected = false;
                        }
                    }
                }
            }

            if root.session.active: VerticalLayout {
                spacing: Theme.gap-md;
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    if root.current.kind != 2: TermInput {
                        label: @tr("REPS");
                        input-type: number;
                        text <=> root.reps-text;
                        accepted => { root.submit-set(); }
                    }
                    if root.current.kind != 2: TermInput {
                        label: root.current.kind == 1 ? @tr("EXTRA WEIGHT") : @tr("WEIGHT");
                        suffix: "kg";
                        text <=> root.weight-text;
                        accepted => { root.submit-set(); }
                    }
                    if root.current.kind == 2: TermInput {
                        label: @tr("TIME (min:sec)");
                        text <=> root.duration-text;
                        accepted => { root.submit-set(); }
                    }
                }
                if root.rejected: Text {
                    text: root.current.kind == 2
                        ? @tr("Write the time as seconds (90) or minutes:seconds (1:30).")
                        : root.current.kind == 1
                            ? @tr("Reps must be between 1 and 200. Extra weight is optional, up to 1000 kg.")
                            : @tr("Reps must be between 1 and 200, and weight between 0 and 1000 kg.");
                    wrap: word-wrap;
                    color: Theme.amber;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-xs;
                }
                TermButton {
                    text: @tr("ADD SET · ENTER");
                    active: true;
                    clicked => { root.submit-set(); }
                }
            }
            if !root.session.active: Text {
                text: @tr("Start a session to log sets.");
                color: Theme.text-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-sm;
            }

        }

        // Series de la sesión
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 300px;
            spacing: Theme.gap-md;

            SectionLabel { text: @tr("SETS"); }
            if root.sets.length == 0: Text {
                text: root.session.active ? @tr("No sets yet. Pick an exercise and log the first one.") : "";
                wrap: word-wrap;
                color: Theme.text-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-sm;
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    for row[i] in root.sets: SetLine {
                        number: root.sets.length - i;
                        entry: root.sets[root.sets.length - 1 - i];
                        newest: i == 0;
                    }
                }
            }
        }
    }
}

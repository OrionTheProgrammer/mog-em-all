import { Theme } from "../theme/theme.slint";
import { Labels } from "../theme/labels.slint";
import { BmiResult, OperatorInfo, WeekStats } from "../types.slint";
import { Insignia } from "../components/logo.slint";
import { SegmentBar } from "../components/progress.slint";
import { TermInput } from "../components/input.slint";
import { SectionLabel, Brackets, StatRow } from "../components/hud.slint";
import { TermButton } from "../components/button.slint";
import { TrainingState } from "../state/training.slint";
import { ScheduleState } from "../state/schedule.slint";
import { TasksState } from "../state/tasks.slint";
import { SettingsState } from "../state/settings.slint";
import { FinanceState } from "../state/finance.slint";

// Pestaña PANEL del HUD: misión del día, rango al centro, escuadra y estado.
export component Overview {
    in property <OperatorInfo> operator;
    in property <WeekStats> week;
    in-out property <BmiResult> bmi;
    callback compute-bmi(string, string) -> BmiResult;
    callback go-training();
    callback go-settings();
    callback go-finance();

    property <bool> has-routine-today: TrainingState.today-count > 0;

    property <float> shown: 0;
    opacity: root.shown;
    animate opacity { duration: Theme.normal; }
    init => { root.shown = 1; }

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 28px;
        padding-bottom: 20px;
        spacing: 32px;

        // Misión del día y agenda
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 240px;
            alignment: start;
            spacing: Theme.gap-md;

            SectionLabel { text: @tr("TODAY'S MISSION"); }
            if TrainingState.session.active: VerticalLayout {
                spacing: Theme.gap-sm;
                Text {
                    text: TrainingState.session.name.to-uppercase();
                    color: Theme.red;
                    font-family: Theme.font-display;
                    font-weight: 700;
                    font-size: 30px;
                    letter-spacing: 2px;
                }
                TermButton {
                    text: @tr("CONTINUE SESSION");
                    active: true;
                    clicked => { root.go-training(); }
                }
            }
            if !TrainingState.session.active: VerticalLayout {
                spacing: Theme.gap-sm;
                for routine in TrainingState.routines: VerticalLayout {
                    spacing: Theme.gap-sm;
                    if routine.today: Text {
                        text: routine.name.to-uppercase();
                        color: Theme.red;
                        font-family: Theme.font-display;
                        font-weight: 700;
                        font-size: 30px;
                        letter-spacing: 2px;
                    }
                    if routine.today: TermButton {
                        text: @tr("START · {n} exercise" | "START · {n} exercises" % routine.exercise-count);
                        active: true;
                        clicked => {
                            TrainingState.start-routine(routine.id);
                            root.go-training();
                        }
                    }
                }
                if !root.has-routine-today: VerticalLayout {
                    spacing: Theme.gap-sm;
                    Text {
                        text: @tr("REST DAY");
                        color: Theme.red;
                        font-family: Theme.font-display;
                        font-weight: 700;
                        font-size: 30px;
                        letter-spacing: 2px;
                    }
                    Text {
                        text: TrainingState.routines.length == 0
                            ? @tr("Create your routines in TRAINING and assign them to days. Today's will show up here.")
                            : @tr("No routine is assigned to today. You can still start a free session in TRAINING.");
                        wrap: word-wrap;
                        color: Theme.text-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                    }
                }
            }

            Rectangle { height: Theme.gap-md; }
            SectionLabel { text: @tr("LEFT TODAY"); }
            if ScheduleState.today-left.length == 0: Text {
                text: @tr("Nothing else on your schedule today.");
                wrap: word-wrap;
                color: Theme.text-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-sm;
            }
            for b in ScheduleState.today-left: HorizontalLayout {
                spacing: Theme.gap-md;
                Rectangle {
                    width: 3px;
                    background: Theme.schedule-kinds[b.kind];
                }
                Text {
                    width: 46px;
                    text: b.end-min > 0 ? Labels.time(b.start-min) : "—";
                    color: Theme.schedule-kinds[b.kind];
                    font-family: Theme.font-mono;
                    font-size: Theme.size-sm;
                }
                Text {
                    horizontal-stretch: 1;
                    text: b.title;
                    overflow: elide;
                    color: Theme.text;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-sm;
                }
            }
        }

        // Rango
        Rectangle {
            horizontal-stretch: 2;
            min-width: 360px;

            Brackets {
                width: 100%;
                height: 100%;
                inset: 24px;
            }

            VerticalLayout {
                alignment: center;
                spacing: Theme.gap-sm;
                padding: 24px;

                HorizontalLayout {
                    alignment: center;
                    Insignia {
                        size: 170px;
                        lit: root.operator.division;
                    }
                }
                Text {
                    text: Labels.rank(root.operator.tier, root.operator.division);
                    horizontal-alignment: center;
                    color: Theme.cyan;
                    font-family: Theme.font-display;
                    font-weight: 700;
                    font-size: 24px;
                    letter-spacing: 8px;
                }
                Text {
                    text: @tr("LV {}", root.operator.level);
                    horizontal-alignment: center;
                    color: Theme.red;
                    font-family: Theme.font-display;
                    font-weight: 700;
                    font-size: 96px;
                }
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: 420px;
                        spacing: Theme.gap-sm;
                        SegmentBar {
                            height: 10px;
                            segments: 40;
                            value: root.operator.xp-for-next > 0 ? root.operator.xp-in-level / root.operator.xp-for-next : 1;
                        }
                        HorizontalLayout {
                            Text {
                                text: root.operator.xp-for-next > 0 ? @tr("{} / {} XP", root.operator.xp-in-level, root.operator.xp-for-next) : @tr("Maximum level");
                                color: Theme.text-dim;
                                font-family: Theme.font-mono;
                                font-size: Theme.size-xs;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.operator.next-division-level > 0
                                    ? @tr("{} AT LV {}",
                                        root.operator.division < 3
                                            ? Labels.rank(root.operator.tier, root.operator.division + 1)
                                            : Labels.rank(root.operator.tier + 1, 1),
                                        root.operator.next-division-level)
                                    : "";
                                color: Theme.text-dim;
                                font-family: Theme.font-mono;
                                font-size: Theme.size-xs;
                            }
                        }
                    }
                }
            }
        }

        // Escuadra y estado
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 260px;
            alignment: start;
            spacing: Theme.gap-md;

            SectionLabel { text: @tr("SQUAD"); }
            Text {
                text: @tr("Sharing routines with friends and comparing progress comes in a later phase.");
                wrap: word-wrap;
                color: Theme.text-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-sm;
            }

            Rectangle { height: 1px; background: Theme.red-dim; }

            SectionLabel { text: @tr("STATUS"); }
            StatRow {
                label: @tr("Streak");
                value: @tr("{n} week" | "{n} weeks" % root.week.streak-weeks);
            }
            StatRow {
                label: @tr("This week");
                value: @tr("{n} session" | "{n} sessions" % root.week.sessions);
            }
            StatRow {
                label: @tr("Tasks");
                value: TasksState.overdue-count > 0
                    ? @tr("{} pending · {} overdue", TasksState.pending-count, TasksState.overdue-count)
                    : @tr("{} pending", TasksState.pending-count);
                value-color: TasksState.overdue-count > 0 ? Theme.amber : Theme.red-glow;
            }
            StatRow {
                label: @tr("Month balance");
                value: FinanceState.month-offset == 0 ? FinanceState.balance-text : "--";
                value-color: FinanceState.balance-negative ? Theme.red-glow : Theme.cyan;
            }

            Rectangle { height: 1px; background: Theme.red-dim; }

            SectionLabel { text: @tr("BODY"); }
            StatRow {
                label: @tr("Weight");
                value: SettingsState.weight != "" ? SettingsState.weight + " kg" : "--";
            }
            StatRow {
                label: @tr("Height");
                value: SettingsState.height != "" ? SettingsState.height + " cm" : "--";
            }
            StatRow {
                label: @tr("BMI");
                value: root.bmi.valid ? (Math.round(root.bmi.value * 10) / 10) + " · " + Labels.bmi-category(root.bmi.category) : "--";
                value-color: root.bmi.valid ? Theme.cyan : Theme.text-dim;
            }
            HorizontalLayout {
                alignment: start;
                TermButton {
                    text: root.bmi.valid ? @tr("UPDATE WEIGHT") : @tr("ADD WEIGHT AND HEIGHT");
                    compact: true;
                    clicked => { root.go-settings(); }
                }
            }
            Text {
                text: @tr("Reference only: BMI does not tell muscle from fat.");
                wrap: word-wrap;
                color: Theme.red-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-xs;
            }
        }
    }
}

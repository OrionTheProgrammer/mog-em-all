import { Theme } from "../theme/theme.slint";
import { Labels } from "../theme/labels.slint";
import { BmiResult, OperatorInfo, WeekStats } from "../types.slint";
import { SectionLabel, StatRow } from "../components/hud.slint";
import { TermButton } from "../components/button.slint";
import { TrainingState } from "../state/training.slint";
import { ScheduleState } from "../state/schedule.slint";
import { TasksState } from "../state/tasks.slint";
import { FinanceState } from "../state/finance.slint";
import { ShellState } from "../state/shell.slint";

component Card inherits Rectangle {
    in property <bool> hero;
    background: root.hero ? #1d0509 : Theme.panel;
    border-width: root.hero ? 0px : 1px;
    border-color: #3a0a10;
    if root.hero: Rectangle {
        y: 0;
        height: 2px;
        background: Theme.red;
    }
}

// Enlace de texto al pie de una tarjeta: "VER SEMANA →".
component CardLink inherits Text {
    callback clicked;
    color: touch.has-hover ? Theme.text : Theme.cyan;
    font-family: Theme.font-mono;
    font-size: Theme.size-xs;
    letter-spacing: 2px;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Checkbox inherits Rectangle {
    callback toggled;
    width: 18px;
    height: 18px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.red : Theme.red-dim;
    background: touch.has-hover ? Theme.red-faint : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// Pestaña PANEL: el día de un vistazo, en tarjetas.
export component Overview {
    in property <OperatorInfo> operator;
    in property <WeekStats> week;
    in-out property <BmiResult> bmi;
    callback compute-bmi(string, string) -> BmiResult;
    callback go(int);

    property <float> shown: 0;
    opacity: root.shown;
    animate opacity { duration: Theme.normal; }
    init => { root.shown = 1; }

    VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 8px;
        padding-bottom: 12px;
        spacing: 16px;

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            // Entrenamiento de hoy
            Card {
                hero: true;
                horizontal-stretch: 2;
                HorizontalLayout {
                    padding: 24px;
                    spacing: 28px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 10px;
                        SectionLabel {
                            text: TrainingState.session.active ? @tr("SESSION IN PROGRESS")
                                : ShellState.today.routine-id == 0 ? @tr("TODAY'S TRAINING")
                                : ShellState.today.start-min >= 0 ? @tr("TODAY'S TRAINING · {}", Labels.time(ShellState.today.start-min))
                                : @tr("TODAY'S TRAINING");
                        }
                        Text {
                            text: TrainingState.session.active ? TrainingState.session.name.to-uppercase()
                                : ShellState.today.routine-id != 0 ? ShellState.today.name.to-uppercase()
                                : @tr("REST DAY");
                            overflow: elide;
                            color: Theme.red;
                            font-family: Theme.font-display;
                            font-weight: 700;
                            font-size: 46px;
                            letter-spacing: 3px;
                        }
                        Text {
                            text: TrainingState.session.active ? @tr("You left it open. Pick up where you were.")
                                : ShellState.today.routine-id != 0
                                    ? @tr("{n} exercise" | "{n} exercises" % ShellState.today.exercise-count) + " · ~" + ShellState.today.duration-min + " min"
                                : TrainingState.routines.length == 0
                                    ? @tr("Create your routines in TRAINING and assign them to days. Today's will show up here.")
                                    : @tr("No routine is assigned to today. You can still start a free session in TRAINING.");
                            wrap: word-wrap;
                            color: Theme.text;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-sm;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 10px;
                            if TrainingState.session.active: TermButton {
                                text: @tr("CONTINUE SESSION");
                                active: true;
                                clicked => { root.go(1); }
                            }
                            if !TrainingState.session.active && ShellState.today.routine-id != 0: TermButton {
                                text: @tr("START");
                                active: true;
                                clicked => {
                                    TrainingState.start-routine(ShellState.today.routine-id);
                                    root.go(1);
                                }
                            }
                            if !TrainingState.session.active: TermButton {
                                text: ShellState.today.routine-id != 0 ? @tr("SEE ROUTINE") : @tr("GO TO TRAINING");
                                clicked => { root.go(1); }
                            }
                        }
                    }
                    if !TrainingState.session.active && ShellState.today.lines.length > 0: VerticalLayout {
                        width: 250px;
                        alignment: center;
                        spacing: 8px;
                        SectionLabel { text: @tr("LAST TIME"); }
                        for line in ShellState.today.lines: HorizontalLayout {
                            spacing: Theme.gap-sm;
                            Text {
                                horizontal-stretch: 1;
                                text: Labels.exercise(line.code, line.name);
                                overflow: elide;
                                color: Theme.text;
                                font-family: Theme.font-mono;
                                font-size: Theme.size-sm;
                            }
                            Text {
                                text: line.last != "" ? line.last : line.target;
                                color: line.last != "" ? Theme.cyan : Theme.text-dim;
                                font-family: Theme.font-mono;
                                font-size: Theme.size-sm;
                            }
                        }
                    }
                }
            }

            // Semana
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    SectionLabel { text: @tr("WEEK · GOAL {}", ShellState.week-goal); }
                    HorizontalLayout {
                        height: 58px;
                        spacing: 6px;
                        for state[i] in ShellState.week-days: VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            Text {
                                text: Labels.weekday(i);
                                horizontal-alignment: center;
                                color: i == TrainingState.weekday ? Theme.cyan : Theme.text-dim;
                                font-family: Theme.font-mono;
                                font-size: Theme.size-xs;
                            }
                            Rectangle {
                                height: 34px;
                                background: state == 2 ? Theme.red : state == 1 ? #ff2a3d33 : #2a070c;
                                border-width: i == TrainingState.weekday ? 1px : 0px;
                                border-color: Theme.cyan;
                            }
                        }
                    }
                    Text {
                        text: @tr("Solid: done · faint: planned · outline: today");
                        color: Theme.text-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-xs;
                    }
                    Rectangle { vertical-stretch: 1; }
                    StatRow {
                        label: @tr("Streak");
                        value: @tr("{n} week" | "{n} weeks" % root.week.streak-weeks);
                        value-color: Theme.cyan;
                    }
                    StatRow {
                        label: @tr("This week");
                        value: @tr("{} of {}", root.week.sessions, ShellState.week-goal);
                        value-color: root.week.sessions >= ShellState.week-goal ? Theme.cyan : Theme.red-glow;
                    }
                    StatRow {
                        label: @tr("BMI");
                        value: root.bmi.valid ? (Math.round(root.bmi.value * 10) / 10) + " · " + Labels.bmi-category(root.bmi.category) : "--";
                        value-color: root.bmi.valid ? Theme.cyan : Theme.text-dim;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            // Lo que queda hoy
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    HorizontalLayout {
                        SectionLabel { text: @tr("LEFT TODAY"); horizontal-stretch: 1; }
                        Text {
                            text: ScheduleState.today-left.length;
                            color: Theme.text-dim;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-xs;
                        }
                    }
                    if ScheduleState.today-left.length == 0: Text {
                        text: @tr("Nothing else on your schedule today.");
                        wrap: word-wrap;
                        color: Theme.text-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                    }
                    for b[i] in ScheduleState.today-left: HorizontalLayout {
                        visible: i < 6;
                        height: i < 6 ? 24px : 0px;
                        spacing: Theme.gap-md;
                        Text {
                            width: 46px;
                            text: b.end-min > 0 ? Labels.time(b.start-min) : "—";
                            vertical-alignment: center;
                            color: Theme.schedule-kinds[b.kind];
                            font-family: Theme.font-mono;
                            font-size: Theme.size-sm;
                        }
                        Rectangle {
                            width: 3px;
                            background: Theme.schedule-kinds[b.kind];
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: b.title;
                            vertical-alignment: center;
                            overflow: elide;
                            color: Theme.text;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-sm;
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    CardLink {
                        text: @tr("SEE WEEK →");
                        clicked => { root.go(3); }
                    }
                }
            }

            // Tareas
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 20px;
                    spacing: 6px;
                    HorizontalLayout {
                        SectionLabel { text: @tr("TASKS"); horizontal-stretch: 1; }
                        if TasksState.overdue-count > 0: Text {
                            text: @tr("{n} overdue" | "{n} overdue" % TasksState.overdue-count);
                            color: Theme.amber;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-xs;
                        }
                    }
                    if ShellState.top-tasks.length == 0: Text {
                        text: @tr("Nothing pending. Write one in the bar above.");
                        wrap: word-wrap;
                        color: Theme.text-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                    }
                    for task in ShellState.top-tasks: Rectangle {
                        height: 36px;
                        background: task.bucket == 0 ? #2a1205 : transparent;
                        Rectangle {
                            x: 0;
                            width: task.bucket == 0 ? 3px : 0px;
                            background: Theme.amber;
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: Theme.gap-md;
                            alignment: stretch;
                            VerticalLayout {
                                alignment: center;
                                Checkbox { toggled => { TasksState.complete(task.id); } }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: task.title;
                                vertical-alignment: center;
                                overflow: elide;
                                color: Theme.text;
                                font-family: Theme.font-mono;
                                font-size: Theme.size-sm;
                            }
                            Text {
                                text: task.bucket == 0 ? @tr("overdue")
                                    : task.due-min >= 0 ? Labels.time(task.due-min)
                                    : task.tag != "" ? "#" + task.tag
                                    : task.bucket == 1 ? @tr("today") : "";
                                vertical-alignment: center;
                                color: task.bucket == 0 ? Theme.amber : task.tag != "" && task.due-min < 0 ? Theme.cyan : Theme.text-dim;
                                font-family: Theme.font-mono;
                                font-size: Theme.size-xs;
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    CardLink {
                        text: @tr("{n} PENDING →" | "{n} PENDING →" % TasksState.pending-count);
                        clicked => { root.go(2); }
                    }
                }
            }

            // Mes
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    SectionLabel { text: @tr("THIS MONTH"); }
                    Text {
                        text: ShellState.month-balance;
                        color: ShellState.month-negative ? Theme.red-glow : Theme.cyan;
                        font-family: Theme.font-display;
                        font-weight: 700;
                        font-size: 34px;
                    }
                    Text {
                        text: @tr("balance · {} spent", ShellState.month-spent);
                        color: Theme.text-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-xs;
                    }
                    for b in ShellState.budgets: VerticalLayout {
                        height: 34px;
                        alignment: start;
                        spacing: 5px;
                        HorizontalLayout {
                            Text {
                                horizontal-stretch: 1;
                                text: Labels.finance-category(b.code, b.name);
                                overflow: elide;
                                color: Theme.text;
                                font-family: Theme.font-mono;
                                font-size: Theme.size-xs;
                            }
                            Text {
                                text: b.spent-text + " / " + b.budget-text;
                                color: b.state >= 2 ? Theme.amber : Theme.text-dim;
                                font-family: Theme.font-mono;
                                font-size: Theme.size-xs;
                            }
                        }
                        Rectangle {
                            height: 5px;
                            background: #2a070c;
                            Rectangle {
                                x: 0;
                                width: parent.width * Math.min(1, b.ratio);
                                background: b.state == 3 ? Theme.red : b.state == 2 ? Theme.amber : Theme.cyan;
                            }
                        }
                    }
                    if ShellState.budgets.length == 0: Text {
                        text: @tr("Give your groups a budget in FINANCES to see them here.");
                        wrap: word-wrap;
                        color: Theme.text-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-xs;
                    }
                    Rectangle { vertical-stretch: 1; }
                    if ShellState.fixed-pending != "": Text {
                        text: @tr("{} is due on the {}", ShellState.fixed-pending, ShellState.fixed-pending-day);
                        overflow: elide;
                        color: Theme.amber;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-xs;
                    }
                    CardLink {
                        text: @tr("SEE FINANCES →");
                        clicked => { root.go(4); }
                    }
                }
            }
        }
    }
}

import { Theme } from "../theme/theme.slint";
import { Labels } from "../theme/labels.slint";
import { BmiResult, OperatorInfo, WeekStats } from "../types.slint";
import { Insignia } from "../components/logo.slint";
import { SegmentBar } from "../components/progress.slint";
import { TermInput } from "../components/input.slint";
import { SectionLabel, Brackets, StatRow } from "../components/hud.slint";

// Pestaña PANEL del HUD: misión del día, rango al centro, escuadra y estado.
export component Overview {
    in property <OperatorInfo> operator;
    in property <WeekStats> week;
    in-out property <BmiResult> bmi;
    callback compute-bmi(string, string) -> BmiResult;

    property <float> shown: 0;
    opacity: root.shown;
    animate opacity { duration: Theme.normal; }
    init => { root.shown = 1; }

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 28px;
        padding-bottom: 20px;
        spacing: 32px;

        // Misión del día
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 240px;
            alignment: start;
            spacing: Theme.gap-md;

            SectionLabel { text: @tr("TODAY'S MISSION"); }
            Text {
                text: @tr("NO ROUTINE YET");
                color: Theme.red;
                font-family: Theme.font-display;
                font-weight: 700;
                font-size: 30px;
                letter-spacing: 2px;
            }
            Rectangle {
                border-width: 0;
                HorizontalLayout {
                    Rectangle { width: 2px; background: Theme.red-dim; }
                    VerticalLayout {
                        padding-left: 16px;
                        spacing: Theme.gap-sm;
                        Text {
                            text: @tr("When you create a routine, today's session and its exercises will show up here.");
                            wrap: word-wrap;
                            color: Theme.text;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-sm;
                        }
                        Text {
                            text: @tr("Routines arrive in phase 1.");
                            wrap: word-wrap;
                            color: Theme.text-dim;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-xs;
                        }
                    }
                }
            }
        }

        // Rango
        Rectangle {
            horizontal-stretch: 2;
            min-width: 360px;

            Brackets {
                width: 100%;
                height: 100%;
                inset: 24px;
            }

            VerticalLayout {
                alignment: center;
                spacing: Theme.gap-sm;
                padding: 24px;

                HorizontalLayout {
                    alignment: center;
                    Insignia {
                        size: 170px;
                        lit: Math.min(3, 1 + Math.floor(root.operator.tier-progress * 3));
                    }
                }
                Text {
                    text: Labels.tier(root.operator.tier).to-uppercase();
                    horizontal-alignment: center;
                    color: Theme.cyan;
                    font-family: Theme.font-display;
                    font-weight: 700;
                    font-size: 24px;
                    letter-spacing: 8px;
                }
                Text {
                    text: @tr("LV {}", root.operator.level);
                    horizontal-alignment: center;
                    color: Theme.red;
                    font-family: Theme.font-display;
                    font-weight: 700;
                    font-size: 96px;
                }
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: 420px;
                        spacing: Theme.gap-sm;
                        SegmentBar {
                            height: 10px;
                            segments: 40;
                            value: root.operator.xp-for-next > 0 ? root.operator.xp-in-level / root.operator.xp-for-next : 1;
                        }
                        HorizontalLayout {
                            Text {
                                text: root.operator.xp-for-next > 0 ? @tr("{} / {} XP", root.operator.xp-in-level, root.operator.xp-for-next) : @tr("Maximum level");
                                color: Theme.text-dim;
                                font-family: Theme.font-mono;
                                font-size: Theme.size-xs;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.operator.next-tier-level > 0 ? @tr("{} AT LV {}", Labels.tier(root.operator.tier + 1).to-uppercase(), root.operator.next-tier-level) : "";
                                color: Theme.text-dim;
                                font-family: Theme.font-mono;
                                font-size: Theme.size-xs;
                            }
                        }
                    }
                }
            }
        }

        // Escuadra y estado
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 260px;
            alignment: start;
            spacing: Theme.gap-md;

            SectionLabel { text: @tr("SQUAD"); }
            Text {
                text: @tr("Sharing routines with friends and comparing progress comes in a later phase.");
                wrap: word-wrap;
                color: Theme.text-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-sm;
            }

            Rectangle { height: 1px; background: Theme.red-dim; }

            SectionLabel { text: @tr("STATUS"); }
            StatRow {
                label: @tr("Streak");
                value: @tr("{} weeks", root.week.streak-weeks);
            }
            StatRow {
                label: @tr("This week");
                value: @tr("{} sessions", root.week.sessions);
            }
            StatRow {
                label: @tr("BMI");
                value: root.bmi.valid ? (Math.round(root.bmi.value * 10) / 10) + " · " + Labels.bmi-category(root.bmi.category) : "--";
                value-color: root.bmi.valid ? Theme.cyan : Theme.text-dim;
            }

            HorizontalLayout {
                spacing: Theme.gap-sm;
                weight := TermInput {
                    label: @tr("WEIGHT");
                    suffix: "kg";
                    edited => { root.bmi = root.compute-bmi(weight.text, height.text); }
                }
                height := TermInput {
                    label: @tr("HEIGHT");
                    suffix: "cm";
                    edited => { root.bmi = root.compute-bmi(weight.text, height.text); }
                }
            }
            Text {
                text: @tr("Reference only: BMI does not tell muscle from fat.");
                wrap: word-wrap;
                color: Theme.red-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-xs;
            }
        }
    }
}

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/theme.slint";
import { Labels } from "../theme/labels.slint";
import { TrainingState, RoutineExerciseRow, SetRow, ExerciseItem } from "../state/training.slint";
import { TermButton } from "../components/button.slint";
import { TermInput } from "../components/input.slint";
import { SegmentBar } from "../components/progress.slint";
import { SectionLabel, KeyHint } from "../components/hud.slint";

// Meta de un ejercicio en una línea: "4 × 6–8 · 70 kg · 2:30".
component TargetText inherits Text {
    in property <RoutineExerciseRow> entry;
    text: (root.entry.kind == 2 ? root.entry.sets + " ×" : root.entry.sets + " × " + (root.entry.reps-min == root.entry.reps-max ? "" + root.entry.reps-min : root.entry.reps-min + "–" + root.entry.reps-max))
        + (root.entry.weight >= 0 ? " · " + Labels.kg(root.entry.weight) : "")
        + " · " + Labels.duration(root.entry.rest-s);
    color: Theme.text-dim;
    font-family: Theme.font-mono;
    font-size: Theme.size-xs;
}

component Muted inherits Text {
    wrap: word-wrap;
    color: Theme.text-dim;
    font-family: Theme.font-mono;
    font-size: Theme.size-sm;
}

// Fila seleccionable de una lista.
component PickRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> badge;
    in property <bool> selected;
    in property <bool> highlight;
    callback clicked;

    height: 46px;
    background: root.selected ? Theme.red-faint : (touch.has-hover ? #ff2a3d10 : transparent);
    border-width: 1px;
    border-color: root.selected ? Theme.red : Theme.red-dim;

    Rectangle {
        x: 0;
        width: root.selected ? 4px : 0px;
        background: Theme.cyan;
        animate width { duration: Theme.normal; }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: Theme.gap-md;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                overflow: elide;
                color: root.highlight ? Theme.cyan : Theme.text;
                font-family: Theme.font-display;
                font-weight: 700;
                font-size: Theme.size-md;
                letter-spacing: 1px;
            }
            if root.detail != "": Text {
                text: root.detail;
                overflow: elide;
                color: Theme.text-dim;
                font-family: Theme.font-mono;
                font-size: Theme.size-xs;
            }
        }
        if root.badge != "": Text {
            text: root.badge;
            vertical-alignment: center;
            color: Theme.cyan;
            font-family: Theme.font-mono;
            font-size: Theme.size-sm;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DayToggles {
    in property <[bool]> days;
    callback toggle(int);

    HorizontalLayout {
        spacing: 4px;
        for i in 7: TermButton {
            text: Labels.weekday(i);
            compact: true;
            active: root.days[i];
            clicked => { root.toggle(i); }
        }
    }
}

// Paso de "primeros pasos": hecho o pendiente.
component Step {
    in property <int> number;
    in property <string> text;
    in property <bool> done;
    HorizontalLayout {
        spacing: Theme.gap-md;
        Text {
            width: 26px;
            text: root.done ? "✓" : root.number;
            color: root.done ? Theme.cyan : Theme.red;
            font-family: Theme.font-display;
            font-weight: 700;
            font-size: Theme.size-md;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            wrap: word-wrap;
            color: root.done ? Theme.text-dim : Theme.text;
            font-family: Theme.font-mono;
            font-size: Theme.size-sm;
        }
    }
}

// Ficha de un ejercicio: qué trabaja, con qué se hace y cómo entra a una rutina.
component ExerciseCard inherits Rectangle {
    in property <ExerciseItem> item;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.red-dim;

    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text {
            text: Labels.exercise(root.item.code, root.item.name);
            wrap: word-wrap;
            color: Theme.red-glow;
            font-family: Theme.font-display;
            font-weight: 700;
            font-size: Theme.size-md;
        }
        Text {
            text: root.item.muscle >= 0
                ? Labels.muscle(root.item.muscle)
                    + (root.item.secondary.length > 0 ? " · " + @tr("also") + " " + Labels.muscle(root.item.secondary[0]) : "")
                    + (root.item.secondary.length > 1 ? ", " + Labels.muscle(root.item.secondary[1]) : "")
                    + (root.item.secondary.length > 2 ? ", " + Labels.muscle(root.item.secondary[2]) : "")
                : @tr("No muscle group");
            wrap: word-wrap;
            color: Theme.cyan;
            font-family: Theme.font-mono;
            font-size: Theme.size-xs;
        }
        Text {
            text: (root.item.equipment >= 0 ? Labels.equipment(root.item.equipment) + " · " : "") + Labels.exercise-kind(root.item.kind);
            color: Theme.text-dim;
            font-family: Theme.font-mono;
            font-size: Theme.size-xs;
        }
        if root.item.lift >= 0: Text {
            text: @tr("Counts for your strength class (E to S).");
            color: Theme.amber;
            font-family: Theme.font-mono;
            font-size: Theme.size-xs;
        }
        if !root.item.custom: Text {
            text: root.item.kind == 2
                ? @tr("Added to a routine with {} rest", Labels.duration(root.item.rest-s))
                : @tr("Added to a routine as {}–{} reps, {} rest", root.item.reps-min, root.item.reps-max, Labels.duration(root.item.rest-s));
            color: Theme.text-dim;
            font-family: Theme.font-mono;
            font-size: Theme.size-xs;
        }
    }
}

// Buscador y filtro por músculo de la biblioteca.
component LibraryFilter {
    callback changed();
    VerticalLayout {
        spacing: 4px;
        TermInput {
            label: @tr("SEARCH");
            text <=> TrainingState.filter-query;
            edited => { root.changed(); }
        }
        // "Todos" más los 13 grupos, en filas de 4 para que quepan en la columna.
        for row in 4: HorizontalLayout {
            spacing: 3px;
            for col in 4: Rectangle {
                property <int> m: row * 4 + col - 1;
                horizontal-stretch: 1;
                height: 28px;
                if self.m <= 12: TermButton {
                    width: 100%;
                    height: 100%;
                    min-width: 0px;
                    tiny: true;
                    text: parent.m < 0 ? @tr("All") : Labels.muscle(parent.m);
                    compact: true;
                    active: TrainingState.filter-muscle == parent.m;
                    clicked => {
                        TrainingState.filter-muscle = parent.m;
                        root.changed();
                    }
                }
            }
        }
    }
}

// Sin sesión: rutinas de hoy, editor de rutinas y biblioteca de ejercicios.
component PlanView {
    property <int> routine-row: -1;
    property <int> library-row: 0;
    property <string> sets-text;
    property <string> reps-min-text;
    property <string> reps-max-text;
    property <string> weight-text;
    property <string> rest-text;
    property <bool> target-error;
    property <bool> confirm-delete;
    property <bool> creating;
    property <string> new-exercise-name;
    property <int> new-exercise-kind: 0;
    property <bool> new-exercise-error;

    function pick-row(i: int) {
        root.routine-row = i;
        root.target-error = false;
        root.sets-text = TrainingState.editing.exercises[i].sets;
        root.reps-min-text = TrainingState.editing.exercises[i].reps-min;
        root.reps-max-text = TrainingState.editing.exercises[i].reps-max;
        root.weight-text = TrainingState.editing.exercises[i].weight >= 0 ? TrainingState.editing.exercises[i].weight : "";
        root.rest-text = Labels.duration(TrainingState.editing.exercises[i].rest-s);
    }

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 24px;
        padding-bottom: 16px;
        spacing: 28px;

        // Hoy y mis rutinas
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 280px;
            spacing: Theme.gap-sm;

            SectionLabel { text: @tr("TODAY · {}", Labels.weekday(TrainingState.weekday)); }
            for routine in TrainingState.routines: VerticalLayout {
                if routine.today: TermButton {
                    text: @tr("START: {}", routine.name.to-uppercase());
                    active: true;
                    clicked => { TrainingState.start-routine(routine.id); }
                }
            }
            free-name := TermInput {
                label: @tr("OR A FREE SESSION");
                text: @tr("Free session");
                accepted => { TrainingState.start-free(self.text); }
            }
            TermButton {
                text: @tr("START FREE SESSION");
                clicked => { TrainingState.start-free(free-name.text); }
            }

            Rectangle { height: Theme.gap-md; }
            SectionLabel { text: @tr("MY ROUTINES"); }
            ScrollView {
                vertical-stretch: 1;
                min-height: 120px;
                VerticalLayout {
                    alignment: start;
                    spacing: Theme.gap-sm;
                    if TrainingState.routines.length == 0: Muted {
                        text: @tr("No routines yet. Create one, for example \"Chest\", and assign it to Monday.");
                    }
                    for routine in TrainingState.routines: PickRow {
                        title: routine.name;
                        detail: (routine.days[0] ? Labels.weekday(0) + " " : "") + (routine.days[1] ? Labels.weekday(1) + " " : "")
                            + (routine.days[2] ? Labels.weekday(2) + " " : "") + (routine.days[3] ? Labels.weekday(3) + " " : "")
                            + (routine.days[4] ? Labels.weekday(4) + " " : "") + (routine.days[5] ? Labels.weekday(5) + " " : "")
                            + (routine.days[6] ? Labels.weekday(6) : "");
                        badge: @tr("{n} exercise" | "{n} exercises" % routine.exercise-count);
                        selected: TrainingState.editing.id == routine.id;
                        highlight: routine.today;
                        clicked => {
                            root.routine-row = -1;
                            root.confirm-delete = false;
                            TrainingState.select-routine(routine.id);
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.gap-sm;
                new-name := TermInput {
                    label: @tr("NEW ROUTINE");
                    accepted => {
                        TrainingState.create-routine(self.text);
                        self.text = "";
                    }
                }
                VerticalLayout {
                    alignment: end;
                    TermButton {
                        text: @tr("CREATE");
                        clicked => {
                            TrainingState.create-routine(new-name.text);
                            new-name.text = "";
                        }
                    }
                }
            }
        }

        // Editor de la rutina
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 340px;
            spacing: Theme.gap-sm;

            if TrainingState.editing.id == 0: VerticalLayout {
                alignment: start;
                spacing: Theme.gap-md;
                if !(TrainingState.steps[0] && TrainingState.steps[1] && TrainingState.steps[2] && TrainingState.steps[3]): VerticalLayout {
                    spacing: Theme.gap-md;
                    SectionLabel { text: @tr("FIRST STEPS"); }
                    Step { number: 1; done: TrainingState.steps[0]; text: @tr("Create a routine for one training day, for example \"Chest\". Bottom left."); }
                    Step { number: 2; done: TrainingState.steps[1]; text: @tr("Add its exercises from the library on the right. Each one comes with a starting goal."); }
                    Step { number: 3; done: TrainingState.steps[2]; text: @tr("Mark the days you do it. On those days it shows up under TODAY."); }
                    Step { number: 4; done: TrainingState.steps[3]; text: @tr("Start it and log each set. The rest timer runs on its own."); }
                    Rectangle { height: Theme.gap-md; }
                }
                SectionLabel { text: @tr("ROUTINE"); }
                Muted { text: @tr("Pick a routine on the left to edit its days and exercises."); }
                Rectangle { height: Theme.gap-md; }
                SectionLabel { text: @tr("RECENT SESSIONS"); }
                if TrainingState.recent.length == 0: Muted { text: @tr("Your finished sessions will show up here."); }
                for item in TrainingState.recent: HorizontalLayout {
                    spacing: Theme.gap-sm;
                    Text {
                        text: Labels.pad(item.day) + "/" + Labels.pad(item.month);
                        color: Theme.red-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: item.name;
                        overflow: elide;
                        color: Theme.text;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                    }
                    Text {
                        text: @tr("{} min · +{} XP", item.duration-min, item.xp);
                        color: Theme.cyan;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                    }
                }
            }

            if TrainingState.editing.id != 0: VerticalLayout {
                spacing: Theme.gap-sm;
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    routine-name := TermInput {
                        label: @tr("ROUTINE");
                        text: TrainingState.editing.name;
                        accepted => { TrainingState.rename-routine(TrainingState.editing.id, self.text); }
                    }
                    VerticalLayout {
                        alignment: end;
                        TermButton {
                            text: @tr("RENAME");
                            clicked => { TrainingState.rename-routine(TrainingState.editing.id, routine-name.text); }
                        }
                    }
                }
                SectionLabel { text: @tr("DAYS"); }
                DayToggles {
                    days: TrainingState.editing.days;
                    toggle(day) => { TrainingState.toggle-day(TrainingState.editing.id, day); }
                }
                SectionLabel { text: @tr("EXERCISES"); }
                ScrollView {
                    vertical-stretch: 1;
                    min-height: 120px;
                    VerticalLayout {
                        alignment: start;
                        spacing: Theme.gap-sm;
                        if TrainingState.editing.exercises.length == 0: Muted {
                            text: @tr("Add exercises from the list on the right.");
                        }
                        for entry[i] in TrainingState.editing.exercises: PickRow {
                            title: (i + 1) + ". " + Labels.exercise(entry.code, entry.name);
                            selected: root.routine-row == i;
                            clicked => { root.pick-row(i); }
                            TargetText {
                                x: parent.width - self.preferred-width - 12px;
                                y: (parent.height - self.preferred-height) / 2;
                                entry: entry;
                            }
                        }
                    }
                }

                if root.routine-row >= 0 && root.routine-row < TrainingState.editing.exercises.length: VerticalLayout {
                    spacing: Theme.gap-sm;
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        TermInput { label: @tr("SETS"); text <=> root.sets-text; }
                        if TrainingState.editing.exercises[root.routine-row].kind != 2: TermInput { label: @tr("REPS MIN"); text <=> root.reps-min-text; }
                        if TrainingState.editing.exercises[root.routine-row].kind != 2: TermInput { label: @tr("REPS MAX"); text <=> root.reps-max-text; }
                        if TrainingState.editing.exercises[root.routine-row].kind != 2: TermInput { label: @tr("WEIGHT"); suffix: "kg"; text <=> root.weight-text; }
                        TermInput { label: @tr("REST"); text <=> root.rest-text; }
                    }
                    if root.target-error: Text {
                        text: @tr("Sets 1–20, reps 1–200 with min ≤ max, weight up to 1000 kg, rest as seconds or min:sec.");
                        wrap: word-wrap;
                        color: Theme.amber;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-xs;
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-sm;
                        TermButton {
                            text: @tr("SAVE TARGET");
                            active: true;
                            clicked => {
                                root.target-error = !TrainingState.save-target(
                                    TrainingState.editing.exercises[root.routine-row].id,
                                    root.sets-text, root.reps-min-text, root.reps-max-text, root.weight-text, root.rest-text);
                            }
                        }
                        TermButton {
                            text: "▲";
                            compact: true;
                            clicked => {
                                TrainingState.move-in-routine(TrainingState.editing.exercises[root.routine-row].id, -1);
                                root.routine-row = Math.max(0, root.routine-row - 1);
                            }
                        }
                        TermButton {
                            text: "▼";
                            compact: true;
                            clicked => {
                                TrainingState.move-in-routine(TrainingState.editing.exercises[root.routine-row].id, 1);
                                root.routine-row = Math.min(TrainingState.editing.exercises.length - 1, root.routine-row + 1);
                            }
                        }
                        TermButton {
                            text: @tr("REMOVE");
                            compact: true;
                            clicked => {
                                TrainingState.remove-from-routine(TrainingState.editing.exercises[root.routine-row].id);
                                root.routine-row = -1;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    TermButton {
                        text: root.confirm-delete ? @tr("CLICK AGAIN TO DELETE") : @tr("DELETE ROUTINE");
                        compact: true;
                        clicked => {
                            if (root.confirm-delete) {
                                TrainingState.delete-routine(TrainingState.editing.id);
                                root.confirm-delete = false;
                                root.routine-row = -1;
                            } else {
                                root.confirm-delete = true;
                            }
                        }
                    }
                }
            }
        }

        // Biblioteca de ejercicios
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 300px;
            spacing: Theme.gap-sm;
            SectionLabel {
                text: @tr("EXERCISE LIBRARY · {} OF {}", TrainingState.exercises.length, TrainingState.exercises-total);
            }
            LibraryFilter {
                vertical-stretch: 0;
                changed => {
                    root.library-row = 0;
                    TrainingState.filter-changed();
                }
            }
            ScrollView {
                vertical-stretch: 1;
                min-height: 120px;
                VerticalLayout {
                    alignment: start;
                    spacing: 3px;
                    if TrainingState.exercises.length == 0: Muted { text: @tr("Nothing matches. Try another word or pick All."); }
                    for item[i] in TrainingState.exercises: TermButton {
                        text: Labels.exercise(item.code, item.name);
                        compact: true;
                        active: root.library-row == i;
                        clicked => { root.library-row = i; }
                    }
                }
            }
            if !root.creating && root.library-row < TrainingState.exercises.length: ExerciseCard {
                item: TrainingState.exercises[root.library-row];
            }
            if !root.creating: HorizontalLayout {
                spacing: Theme.gap-sm;
                TermButton {
                    horizontal-stretch: 1;
                    text: TrainingState.editing.id != 0 ? @tr("ADD TO {}", TrainingState.editing.name.to-uppercase()) : @tr("PICK A ROUTINE TO ADD");
                    active: TrainingState.editing.id != 0 && TrainingState.exercises.length > 0;
                    clicked => {
                        if (TrainingState.editing.id != 0 && root.library-row < TrainingState.exercises.length) {
                            TrainingState.add-to-routine(TrainingState.editing.id, TrainingState.exercises[root.library-row].id);
                        }
                    }
                }
                TermButton {
                    text: @tr("NEW");
                    compact: true;
                    clicked => {
                        root.creating = true;
                        root.new-exercise-error = false;
                    }
                }
            }
            if root.creating: VerticalLayout {
                spacing: Theme.gap-sm;
                SectionLabel { text: @tr("NEW EXERCISE"); }
                TermInput {
                    label: @tr("NAME");
                    text <=> root.new-exercise-name;
                }
                HorizontalLayout {
                    spacing: 3px;
                    for k in 3: TermButton {
                        text: k == 0 ? @tr("Weight") : k == 1 ? @tr("Bodyweight") : @tr("Time");
                        compact: true;
                        active: root.new-exercise-kind == k;
                        clicked => { root.new-exercise-kind = k; }
                    }
                }
                Muted {
                    text: TrainingState.filter-muscle >= 0
                        ? @tr("Muscle group: {} (the one picked above).", Labels.muscle(TrainingState.filter-muscle))
                        : @tr("Pick a muscle group above if you want the exercise filed under one.");
                }
                if root.new-exercise-error: Text {
                    text: @tr("Write a name.");
                    color: Theme.amber;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-xs;
                }
                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    TermButton {
                        horizontal-stretch: 1;
                        text: @tr("CREATE EXERCISE");
                        active: true;
                        clicked => {
                            if (TrainingState.create-exercise(root.new-exercise-name, root.new-exercise-kind, TrainingState.filter-muscle)) {
                                root.creating = false;
                                root.new-exercise-name = "";
                            } else {
                                root.new-exercise-error = true;
                            }
                        }
                    }
                    TermButton {
                        text: @tr("CANCEL");
                        compact: true;
                        clicked => { root.creating = false; }
                    }
                }
            }
        }
    }
}

// Cuenta regresiva del descanso entre series.
component RestPanel inherits Rectangle {
    property <int> remaining: TrainingState.rest-until - TrainingState.now;
    property <bool> resting: root.remaining > 0;
    property <bool> go: !root.resting && TrainingState.rest-total > 0 && -root.remaining < 6;
    property <float> t: animation-tick() / 1ms;

    visible: root.resting || root.go;
    height: root.visible ? 150px : 0px;
    border-width: 1px;
    border-color: root.go ? Theme.cyan : Theme.red-dim;
    background: root.go && Math.mod(root.t, 500) < 250 ? #2ef2ff22 : Theme.panel;

    VerticalLayout {
        padding: 16px;
        spacing: Theme.gap-sm;
        HorizontalLayout {
            Text {
                horizontal-stretch: 1;
                text: root.go ? @tr("NEXT SET!") : @tr("REST");
                color: root.go ? Theme.cyan : Theme.text-dim;
                font-family: Theme.font-display;
                font-weight: 700;
                font-size: root.go ? 34px : 18px;
                letter-spacing: 4px;
            }
            if root.resting: Text {
                text: Labels.duration(root.remaining);
                color: root.remaining <= 10 ? Theme.amber : Theme.cyan;
                font-family: Theme.font-mono;
                font-size: 52px;
            }
        }
        if root.resting: SegmentBar {
            height: 10px;
            segments: 40;
            color: Theme.cyan;
            value: TrainingState.rest-total > 0 ? root.remaining / TrainingState.rest-total : 0;
        }
        if root.resting: HorizontalLayout {
            spacing: Theme.gap-sm;
            alignment: start;
            TermButton { text: "−15 s"; compact: true; clicked => { TrainingState.adjust-rest(-15); } }
            TermButton { text: "+15 s"; compact: true; clicked => { TrainingState.adjust-rest(15); } }
            TermButton { text: @tr("SKIP"); compact: true; clicked => { TrainingState.skip-rest(); } }
        }
    }
}

// Con sesión: plan del día, ejercicio actual con descanso, y series hechas.
component SessionView {
    property <int> elapsed: Math.max(0, TrainingState.now - TrainingState.session.started-at);
    property <int> set-type: 0;
    property <string> reps-text;
    property <string> weight-text;
    property <string> duration-text;
    property <bool> rejected;
    property <bool> picking;
    property <bool> confirm-discard;

    property <int> current-id: TrainingState.current.id;
    changed current-id => {
        root.reps-text = TrainingState.current.suggest-reps;
        root.weight-text = TrainingState.current.suggest-weight;
        root.rejected = false;
    }
    init => {
        root.reps-text = TrainingState.current.suggest-reps;
        root.weight-text = TrainingState.current.suggest-weight;
    }

    function submit() {
        if (TrainingState.add-set(TrainingState.current.id, root.reps-text, root.weight-text, root.duration-text, root.set-type)) {
            root.rejected = false;
            root.duration-text = "";
            root.reps-text = TrainingState.current.suggest-reps;
            root.weight-text = TrainingState.current.suggest-weight;
        } else {
            root.rejected = true;
        }
    }

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 24px;
        padding-bottom: 16px;
        spacing: 28px;

        // Plan
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 280px;
            spacing: Theme.gap-sm;

            SectionLabel { text: @tr("SESSION IN PROGRESS"); }
            HorizontalLayout {
                Text {
                    horizontal-stretch: 1;
                    text: TrainingState.session.name;
                    overflow: elide;
                    color: Theme.red;
                    font-family: Theme.font-display;
                    font-weight: 700;
                    font-size: 30px;
                }
                Text {
                    text: Labels.duration(root.elapsed);
                    vertical-alignment: center;
                    color: Theme.cyan;
                    font-family: Theme.font-mono;
                    font-size: 26px;
                }
            }

            SectionLabel { text: @tr("PLAN · PICK WHAT YOU DO NOW"); }
            ScrollView {
                vertical-stretch: 1;
                min-height: 140px;
                VerticalLayout {
                    alignment: start;
                    spacing: Theme.gap-sm;
                    if TrainingState.plan.length == 0 && !root.picking: Muted {
                        text: @tr("Free session: pick any exercise with \"Other exercise\".");
                    }
                    for entry in TrainingState.plan: PickRow {
                        title: Labels.exercise(entry.code, entry.name);
                        detail: (entry.kind == 2 ? entry.sets + " ×" : entry.sets + " × " + entry.reps-min + "–" + entry.reps-max)
                            + (entry.weight >= 0 ? " · " + Labels.kg(entry.weight) : "");
                        badge: entry.done + " / " + entry.sets;
                        selected: TrainingState.current.id == entry.exercise-id && !root.picking;
                        highlight: entry.done >= entry.sets;
                        clicked => {
                            root.picking = false;
                            TrainingState.select-exercise(entry.exercise-id);
                        }
                    }
                    if root.picking: VerticalLayout {
                        spacing: 4px;
                        for item in TrainingState.exercises: TermButton {
                            text: Labels.exercise(item.code, item.name);
                            compact: true;
                            active: TrainingState.current.id == item.id;
                            clicked => {
                                root.picking = false;
                                TrainingState.select-exercise(item.id);
                            }
                        }
                    }
                }
            }
            TermButton {
                text: root.picking ? @tr("BACK TO PLAN") : @tr("OTHER EXERCISE");
                compact: true;
                clicked => { root.picking = !root.picking; }
            }
            HorizontalLayout {
                spacing: Theme.gap-sm;
                TermButton {
                    text: @tr("FINISH");
                    active: true;
                    clicked => { TrainingState.finish-session(); }
                }
                TermButton {
                    text: root.confirm-discard ? @tr("CLICK AGAIN") : @tr("DISCARD");
                    clicked => {
                        if (root.confirm-discard) {
                            TrainingState.discard-session();
                            root.confirm-discard = false;
                        } else {
                            root.confirm-discard = true;
                        }
                    }
                }
            }
        }

        // Ejercicio actual. Todo arriba: que nada se mueva cuando aparece el descanso.
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 340px;
            spacing: Theme.gap-md;
            alignment: start;

            SectionLabel { text: @tr("NOW"); }
            if TrainingState.current.id == 0: Muted { text: @tr("Pick an exercise to start."); }
            if TrainingState.current.id != 0: VerticalLayout {
                spacing: Theme.gap-md;
                Text {
                    text: Labels.exercise(TrainingState.current.code, TrainingState.current.name).to-uppercase();
                    wrap: word-wrap;
                    color: Theme.red;
                    font-family: Theme.font-display;
                    font-weight: 700;
                    font-size: 40px;
                    letter-spacing: 2px;
                }
                Text {
                    text: TrainingState.current.in-routine
                        ? (TrainingState.current.done >= TrainingState.current.sets
                            ? @tr("Goal done ({} sets). Extra sets also count.", TrainingState.current.sets)
                            : @tr("Set {} of {} · goal {}–{} reps", TrainingState.current.done + 1, TrainingState.current.sets, TrainingState.current.reps-min, TrainingState.current.reps-max))
                        : @tr("Set {}", TrainingState.current.done + 1);
                    color: Theme.cyan;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-sm;
                }

                SectionLabel { text: @tr("SET TYPE"); }
                HorizontalLayout {
                    spacing: 4px;
                    // En el orden en que se suelen hacer: calentamiento, aproximación, trabajo, al fallo...
                    for t in [0, 1, 5, 4, 2, 3]: TermButton {
                        text: Labels.set-type(t);
                        compact: true;
                        active: root.set-type == t;
                        clicked => { root.set-type = t; }
                    }
                }
                Text {
                    text: Labels.set-type-help(root.set-type);
                    wrap: word-wrap;
                    color: Theme.text-dim;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-xs;
                }

                HorizontalLayout {
                    spacing: Theme.gap-sm;
                    if TrainingState.current.kind != 2: TermInput {
                        label: @tr("REPS");
                        input-type: number;
                        text <=> root.reps-text;
                        accepted => { root.submit(); }
                    }
                    if TrainingState.current.kind != 2: TermInput {
                        label: TrainingState.current.kind == 1 ? @tr("EXTRA WEIGHT") : @tr("WEIGHT");
                        suffix: "kg";
                        text <=> root.weight-text;
                        accepted => { root.submit(); }
                    }
                    if TrainingState.current.kind == 2: TermInput {
                        label: @tr("TIME (min:sec)");
                        text <=> root.duration-text;
                        accepted => { root.submit(); }
                    }
                }
                if root.rejected: Text {
                    text: TrainingState.current.kind == 2
                        ? @tr("Write the time as seconds (90) or minutes:seconds (1:30).")
                        : @tr("Reps must be between 1 and 200, and weight between 0 and 1000 kg.");
                    wrap: word-wrap;
                    color: Theme.amber;
                    font-family: Theme.font-mono;
                    font-size: Theme.size-xs;
                }
                TermButton {
                    text: @tr("SET DONE · ENTER");
                    active: true;
                    clicked => { root.submit(); }
                }
                RestPanel { }
                if TrainingState.next.exercise-id != 0 && TrainingState.next.exercise-id != TrainingState.current.id: HorizontalLayout {
                    spacing: Theme.gap-sm;
                    Text {
                        text: @tr("NEXT");
                        color: Theme.text-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-xs;
                        letter-spacing: 3px;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: Labels.exercise(TrainingState.next.code, TrainingState.next.name) + " · "
                            + TrainingState.next.sets + " × " + TrainingState.next.reps-min + "–" + TrainingState.next.reps-max;
                        overflow: elide;
                        color: Theme.text;
                        font-family: Theme.font-mono;
                        font-size: Theme.size-sm;
                        vertical-alignment: center;
                    }
                    TermButton {
                        text: @tr("GO");
                        compact: true;
                        clicked => { TrainingState.select-exercise(TrainingState.next.exercise-id); }
                    }
                }
            }
        }

        // Series
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 260px;
            spacing: Theme.gap-sm;
            HorizontalLayout {
                SectionLabel {
                    horizontal-stretch: 1;
                    text: @tr("SETS");
                }
                TermButton {
                    text: @tr("UNDO LAST");
                    compact: true;
                    clicked => { TrainingState.undo-set(); }
                }
            }
            if TrainingState.sets.length == 0: Muted { text: @tr("Your sets will show up here."); }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    for row[i] in TrainingState.sets: HorizontalLayout {
                        property <SetRow> entry: TrainingState.sets[TrainingState.sets.length - 1 - i];
                        height: 32px;
                        spacing: Theme.gap-sm;
                        Text {
                            width: 34px;
                            text: "#" + (TrainingState.sets.length - i);
                            vertical-alignment: center;
                            color: Theme.red-dim;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-sm;
                        }
                        Text {
                            width: 26px;
                            text: Labels.set-type-tag(entry.set-type);
                            vertical-alignment: center;
                            color: Theme.amber;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-xs;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: Labels.exercise(entry.code, entry.name);
                            overflow: elide;
                            vertical-alignment: center;
                            color: i == 0 ? Theme.cyan : Theme.text;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-sm;
                        }
                        Text {
                            text: entry.kind == 2
                                ? Labels.duration(entry.duration-s)
                                : entry.kind == 1 && entry.weight <= 0
                                    ? @tr("{} reps", entry.reps)
                                    : entry.reps + " × " + Labels.kg(entry.weight);
                            vertical-alignment: center;
                            color: Theme.red-glow;
                            font-family: Theme.font-mono;
                            font-size: Theme.size-sm;
                        }
                    }
                }
            }
        }
    }
}

// Indicación de una línea con la acción que toca ahora y sus teclas.
component HintBar inherits Rectangle {
    in property <string> text;
    in property <string> key;
    height: 34px;
    background: Theme.panel;
    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        spacing: Theme.gap-md;
        if root.key != "": VerticalLayout {
            alignment: center;
            KeyHint { key: root.key; }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            vertical-alignment: center;
            overflow: elide;
            color: Theme.text;
            font-family: Theme.font-mono;
            font-size: Theme.size-sm;
        }
    }
}

// Pestaña ENTRENAMIENTO.
export component Training {
    property <float> shown: 0;
    opacity: root.shown;
    animate opacity { duration: Theme.normal; }
    init => { root.shown = 1; }

    property <bool> resting: TrainingState.rest-until > TrainingState.now;

    VerticalLayout {
        Rectangle {
            vertical-stretch: 1;
            if !TrainingState.session.active: PlanView {
                width: 100%;
                height: 100%;
            }
            if TrainingState.session.active: SessionView {
                width: 100%;
                height: 100%;
            }
        }
        HintBar {
            key: TrainingState.session.active && TrainingState.current.id != 0 && !root.resting ? "ENTER" : "";
            text: TrainingState.session.active
                ? (TrainingState.current.id == 0
                    ? @tr("Pick an exercise from the plan on the left.")
                    : root.resting
                        ? @tr("Rest. Meanwhile you can adjust reps and weight for the next set.")
                        : @tr("Do the set, check reps and weight, and press ENTER to log it."))
                : TrainingState.routines.length == 0
                    ? @tr("Start by creating a routine: write a name bottom left and press ENTER.")
                    : TrainingState.editing.id == 0
                        ? @tr("Pick a routine to edit it, or start today's at the top left.")
                        : TrainingState.editing.exercises.length == 0
                            ? @tr("Pick an exercise in the library and press ADD.")
                            : !(TrainingState.editing.days[0] || TrainingState.editing.days[1] || TrainingState.editing.days[2] || TrainingState.editing.days[3] || TrainingState.editing.days[4] || TrainingState.editing.days[5] || TrainingState.editing.days[6])
                                ? @tr("Mark the days for this routine so it shows up under TODAY.")
                                : @tr("Click an exercise of the routine to change its goal, or keep adding from the library.");
        }
    }
}

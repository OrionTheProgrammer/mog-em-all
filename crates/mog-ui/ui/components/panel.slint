import { Theme } from "../theme/theme.slint";

// Marco con esquinas cortadas en diagonal, la pieza base de toda la interfaz.
export component Panel inherits Rectangle {
    in property <string> title;
    in property <bool> highlighted: false;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        fill: Theme.panel;
        stroke: root.highlighted ? Theme.red : Theme.red-dim;
        stroke-width: 1px;
        animate stroke { duration: Theme.normal; }

        MoveTo { x: 0; y: 0; }
        LineTo { x: (root.width - Theme.corner-cut) / 1px; y: 0; }
        LineTo { x: root.width / 1px; y: Theme.corner-cut / 1px; }
        LineTo { x: root.width / 1px; y: root.height / 1px; }
        LineTo { x: Theme.corner-cut / 1px; y: root.height / 1px; }
        LineTo { x: 0; y: (root.height - Theme.corner-cut) / 1px; }
        Close { }
    }

    // Marca de esquina
    Rectangle {
        x: 0;
        y: 0;
        width: 28px;
        height: 3px;
        background: Theme.red;
    }

    VerticalLayout {
        padding: Theme.gap-lg;
        spacing: Theme.gap-md;

        if root.title != "": Text {
            text: root.title;
            color: Theme.red;
            font-family: Theme.font-display;
            font-size: Theme.size-md;
            font-weight: 700;
            letter-spacing: 3px;
        }

        @children
    }
}

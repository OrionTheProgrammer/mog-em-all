import { Theme } from "../theme/theme.slint";

export component TermButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> compact: false;
    // Aún más chico, para filas de filtros.
    in property <bool> tiny: false;
    callback clicked;

    min-height: root.compact ? 28px : 38px;
    min-width: label.preferred-width + 28px;
    background: root.active ? Theme.red : (touch.has-hover ? Theme.red-faint : transparent);
    border-width: 1px;
    border-color: root.active || touch.has-hover ? Theme.red : Theme.red-dim;
    animate background, border-color { duration: Theme.fast; }

    // Franja cian a la izquierda del botón activo
    Rectangle {
        x: 0;
        width: root.active ? 4px : 0px;
        background: Theme.cyan;
        animate width { duration: Theme.normal; easing: ease-out; }
    }

    HorizontalLayout {
        padding-left: root.tiny ? 4px : root.compact ? 10px : 16px;
        padding-right: root.tiny ? 4px : root.compact ? 10px : 16px;
        label := Text {
            text: root.text;
            vertical-alignment: center;
            horizontal-alignment: root.compact ? center : left;
            color: root.active ? Theme.bg : (touch.has-hover ? Theme.red-glow : Theme.text);
            font-family: Theme.font-display;
            font-size: root.tiny ? Theme.size-xs + 1px : root.compact ? Theme.size-sm : Theme.size-md;
            font-weight: 700;
            letter-spacing: root.tiny ? 0px : root.compact ? 1px : 2px;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

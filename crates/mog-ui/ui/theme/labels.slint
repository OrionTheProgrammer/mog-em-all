// Textos que dependen de valores del motor de lógica (enums -> texto traducido).
// El motor nunca devuelve textos; aquí se decide qué se muestra.

import { CommandFeedback, Clock } from "../types.slint";
import { ExerciseNames } from "exercise-names.slint";

export global Labels {
    // Mismo orden que ranks::Tier en mog-core.
    public pure function tier(t: int) -> string {
        t == 0 ? @tr("No-Name") :
        t == 1 ? @tr("Beginner") :
        t == 2 ? @tr("Selfhater") :
        t == 3 ? @tr("Insane") :
        t == 4 ? @tr("Chad") :
        t == 5 ? @tr("Mogger") :
        @tr("Psycho Mogger")
    }

    // Nombre de un ejercicio: los incluidos se traducen, los propios se muestran tal cual.
    public pure function exercise(code: string, name: string) -> string {
        code != "" ? ExerciseNames.name(code) : name
    }

    // Mismo orden que catalog::Muscle en mog-core.
    public pure function muscle(m: int) -> string {
        m == 0 ? @tr("Chest") :
        m == 1 ? @tr("Back") :
        m == 2 ? @tr("Shoulders") :
        m == 3 ? @tr("Biceps") :
        m == 4 ? @tr("Triceps") :
        m == 5 ? @tr("Forearms") :
        m == 6 ? @tr("Quads") :
        m == 7 ? @tr("Hamstrings") :
        m == 8 ? @tr("Glutes") :
        m == 9 ? @tr("Calves") :
        m == 10 ? @tr("Core") :
        m == 11 ? @tr("Full body") :
        m == 12 ? @tr("Cardio") :
        @tr("Other")
    }

    // Mismo orden que catalog::Equipment.
    public pure function equipment(e: int) -> string {
        e == 0 ? @tr("Barbell") :
        e == 1 ? @tr("Dumbbells") :
        e == 2 ? @tr("Machine") :
        e == 3 ? @tr("Cable") :
        e == 4 ? @tr("Bodyweight") :
        e == 5 ? @tr("Kettlebell") :
        e == 6 ? @tr("Band") :
        e == 7 ? @tr("Smith machine") :
        e == 8 ? @tr("EZ bar") :
        @tr("No equipment")
    }

    public pure function exercise-kind(k: int) -> string {
        k == 0 ? @tr("Weight and reps") : k == 1 ? @tr("Bodyweight, extra weight optional") : @tr("Time")
    }

    // Mismo orden que ranks::Lift.
    public pure function lift(l: int) -> string {
        l == 0 ? ExerciseNames.name("squat") :
        l == 1 ? ExerciseNames.name("bench_press") :
        l == 2 ? ExerciseNames.name("deadlift") :
        l == 3 ? ExerciseNames.name("overhead_press") :
        l == 4 ? ExerciseNames.name("barbell_row") :
        ExerciseNames.name("pull_up")
    }

    public pure function duration(seconds: int) -> string {
        Labels.pad(Math.floor(seconds / 60)) + ":" + Labels.pad(Math.mod(seconds, 60))
    }

    public pure function kg(value: float) -> string {
        (Math.round(value * 10) / 10) + " kg"
    }

    public pure function roman(n: int) -> string {
        n == 1 ? "I" : n == 2 ? "II" : "III"
    }

    // Rango completo con división, en mayúsculas: "CHAD II".
    public pure function rank(t: int, division: int) -> string {
        (Labels.tier(t) + " " + Labels.roman(division)).to-uppercase()
    }

    public pure function bmi-category(c: int) -> string {
        c == 0 ? @tr("Underweight") :
        c == 1 ? @tr("Normal") :
        c == 2 ? @tr("Overweight") :
        @tr("Obese")
    }

    // Mismo orden que command::Module en mog-core.
    public pure function module(m: int) -> string {
        m == 0 ? @tr("DASHBOARD") :
        m == 1 ? @tr("TRAINING") :
        m == 2 ? @tr("TASKS") :
        m == 3 ? @tr("SCHEDULE") :
        m == 4 ? @tr("FINANCES") :
        @tr("SETTINGS")
    }

    // Fase del plan en la que llega cada módulo.
    public pure function module-phase(m: int) -> int {
        m == 2 || m == 3 ? 2 : m == 4 ? 3 : 1
    }

    public pure function weekday(d: int) -> string {
        d == 0 ? @tr("MON") :
        d == 1 ? @tr("TUE") :
        d == 2 ? @tr("WED") :
        d == 3 ? @tr("THU") :
        d == 4 ? @tr("FRI") :
        d == 5 ? @tr("SAT") :
        @tr("SUN")
    }

    public pure function set-type(t: int) -> string {
        t == 1 ? @tr("Warm-up") :
        t == 2 ? @tr("Dropset") :
        t == 3 ? @tr("Superset") :
        t == 4 ? @tr("To failure") :
        t == 5 ? @tr("Approach") :
        @tr("Normal set")
    }

    // Qué significa cada tipo, en una línea.
    public pure function set-type-help(t: int) -> string {
        t == 1 ? @tr("Light sets to get warm. They don't count toward your goal, records or volume.") :
        t == 2 ? @tr("Lower the weight and keep going with no rest. The rest timer won't start.") :
        t == 3 ? @tr("Chain it with another exercise with no rest. The rest timer won't start.") :
        t == 4 ? @tr("Your hardest set, all the way to failure. Counts as a work set.") :
        t == 5 ? @tr("Build up toward your heavy set, for example before going to failure. Not a work set.") :
        @tr("A regular work set. It counts toward the goal of the exercise.")
    }

    // Letra corta para la lista de series.
    public pure function set-type-tag(t: int) -> string {
        t == 1 ? @tr("WU") : t == 2 ? @tr("DS") : t == 3 ? @tr("SS") : t == 4 ? @tr("F") : t == 5 ? @tr("AP") : ""
    }

    // Minutos desde la medianoche como "08:30".
    public pure function time(minutes: int) -> string {
        Labels.pad(Math.floor(minutes / 60)) + ":" + Labels.pad(Math.mod(minutes, 60))
    }

    // Mismo orden que storage::EventKind; el 5 es entrenamiento (una rutina).
    public pure function event-kind(k: int) -> string {
        k == 0 ? @tr("Class") :
        k == 1 ? @tr("Work") :
        k == 2 ? @tr("Study") :
        k == 3 ? @tr("Personal") :
        k == 4 ? @tr("Other") :
        @tr("Training")
    }

    // Mismo orden que tasks::Bucket.
    public pure function task-bucket(b: int) -> string {
        b == 0 ? @tr("OVERDUE") :
        b == 1 ? @tr("TODAY") :
        b == 2 ? @tr("TOMORROW") :
        b == 3 ? @tr("THIS WEEK") :
        b == 4 ? @tr("LATER") :
        @tr("NO DATE")
    }

    public pure function priority(p: int) -> string {
        p == 0 ? @tr("Low") : p == 2 ? @tr("High") : @tr("Normal priority")
    }

    public pure function repeat(r: int) -> string {
        r == 1 ? @tr("Every day") : r == 2 ? @tr("Every week") : r == 3 ? @tr("Every month") : @tr("Doesn't repeat")
    }

    public pure function pad(n: int) -> string {
        n < 10 ? "0" + n : "" + n
    }

    public pure function clock(c: Clock) -> string {
        Labels.weekday(c.weekday) + " " + Labels.pad(c.day) + "/" + Labels.pad(c.month) + " · " + Labels.pad(c.hour) + ":" + Labels.pad(c.minute)
    }

    public pure function feedback(f: CommandFeedback) -> string {
        f.kind == 1 ? @tr("Opened {}", Labels.module(f.module)) :
        f.kind == 2 ? @tr("BMI {}: {}", Math.round(f.value * 10) / 10, Labels.bmi-category(f.category)) :
        f.kind == 3 ? @tr("Language changed") :
        f.kind == 4 ? @tr("Commands: go <module> · bmi <kg> <cm> · lang es|en · help") :
        f.kind == 5 ? @tr("Unknown command. Type help to see the list.") :
        f.kind == 6 ? @tr("Usage: go <module>, for example: go training") :
        f.kind == 7 ? @tr("Usage: bmi <weight kg> <height cm>, for example: bmi 78,5 176") :
        f.kind == 8 ? @tr("Usage: lang es or lang en") :
        f.kind == 9 ? @tr("Out of range: weight must be 20 to 400 kg and height 100 to 250 cm.") :
        f.kind == 10 ? @tr("That language is not available yet.") :
        ""
    }
}

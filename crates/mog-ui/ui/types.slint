// Estructuras que intercambian la interfaz y el motor de lógica.

export struct BmiResult {
    valid: bool,
    value: float,
    // 0 bajo peso, 1 normal, 2 sobrepeso, 3 obesidad
    category: int,
}

export struct OperatorInfo {
    level: int,
    // índice de ranks::Tier
    tier: int,
    xp-in-level: int,
    xp-for-next: int,
    total-xp: int,
    // avance dentro del rango, 0 a 1
    tier-progress: float,
    // nivel donde empieza el siguiente rango; 0 si ya es el último
    next-tier-level: int,
    // división dentro del rango: 1, 2 o 3
    division: int,
    // nivel donde empieza la división siguiente; 0 si ya es la última
    next-division-level: int,
}

export struct WeekStats {
    sessions: int,
    streak-weeks: int,
}

export struct Clock {
    hour: int,
    minute: int,
    // 0 lunes ... 6 domingo
    weekday: int,
    day: int,
    month: int,
}

// Resultado de un comando. `kind` decide qué mensaje se muestra (ver Labels.feedback).
export struct CommandFeedback {
    kind: int,
    module: int,
    value: float,
    category: int,
}
